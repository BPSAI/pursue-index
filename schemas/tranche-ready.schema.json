{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pursueindex.com/schemas/tranche-ready.schema.json",
  "title": "Tranche-ready record",
  "description": "Machine-readable record the poll writes on a confirmed war.gov tranche change, before any spend. One record per tranche CSV sha256, committed at data/tranche-ready/<sha12>.json in pursue-index. This file is the single source: pursue-index (R7C.31) vendors it byte-for-byte, and pursue-opsec (R7C.32) pins its sha256. The operator-message payload is defined under $defs/operator_message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tranche_sha256",
    "tranche_sha12",
    "detected_at",
    "generated_at",
    "status",
    "tranche_issue",
    "supersedes",
    "manifest",
    "diff",
    "candidates",
    "scope",
    "pages",
    "estimate",
    "fetch",
    "generated_by"
  ],
  "properties": {
    "schema_version": {
      "description": "Semantic version of this schema. Vendored copies and pinned test vectors must carry the same value (R7C.31, R7C.32).",
      "const": "1.0.0"
    },
    "example_provenance": {
      "type": "string",
      "description": "Optional. Present only on the committed reference example, naming how it was built. Real poll-written records omit it."
    },
    "tranche_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The upstream CSV sha256. The record's primary key."
    },
    "tranche_sha12": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "First 12 hex chars of tranche_sha256; the filename stem and the id used in messages."
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the poll first confirmed this sha as a change."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this record was written. A recompute for the same sha that disagrees exits non-zero and writes nothing (append-only per sha)."
    },
    "status": {
      "enum": ["ready", "stop-and-ask", "superseded"],
      "description": "ready: every candidate resolved to a disposition and the estimate is complete, the hand-off may launch. stop-and-ask: at least one candidate has a null byte_verdict or the estimate is partial; the brief renders a stop-and-ask and the session waits. superseded: a newer sha replaced this one before hand-off; no session launches for it."
    },
    "stop_reasons": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string" },
      "description": "Human-readable reasons, one per unresolved item. Non-empty iff status == stop-and-ask."
    },
    "tranche_issue": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "The GitHub issue number the poll opened for this tranche, or null if none was opened."
    },
    "supersedes": {
      "type": "array",
      "description": "Older or flapped shas this record subsumes. Empty when there is no prior in-flight sha. A flap (an older upstream copy seen after a newer one, R7C.30) appears here with reason older-last-modified or subset-of-current and opens no session of its own.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tranche_sha256", "tranche_sha12", "reason"],
        "properties": {
          "tranche_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "tranche_sha12": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
          "issue": { "type": ["integer", "null"], "minimum": 1 },
          "reason": {
            "enum": ["older-last-modified", "subset-of-current", "replaced-by-newer"],
            "description": "Why the sha is not shipped: its CSV Last-Modified is older; its rows are a strict subset of the current manifest; or a newer sha arrived first."
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_row_count", "new_row_count", "prior_manifest_sha256", "new_snapshot_sha256"],
      "properties": {
        "old_row_count": { "type": "integer", "minimum": 0 },
        "new_row_count": { "type": "integer", "minimum": 0 },
        "prior_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "new_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts copied from the committed tranche-diff receipt (scripts/tranche_diff.py summary block).",
      "required": [
        "renames_confirmed",
        "new_content",
        "quarantined",
        "removed",
        "field_only_changes",
        "row_changes"
      ],
      "properties": {
        "renames_confirmed": { "type": "integer", "minimum": 0 },
        "new_content": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "field_only_changes": { "type": "integer", "minimum": 0 },
        "row_changes": { "type": "integer", "minimum": 0 },
        "restored_unchanged": { "type": "integer", "minimum": 0 },
        "restored_modified": { "type": "integer", "minimum": 0 },
        "restored_unknown": { "type": "integer", "minimum": 0 }
      }
    },
    "candidates": {
      "type": "array",
      "description": "Every rename or quarantine candidate that needs a verdict. Net-new and removed rows are not candidates. Byte evidence is present when both old and new bytes were fetched credential-free (R7C.31).",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_count", "cards"],
      "description": "Every PDF/IMG card whose bytes are new or changed and will be in the promoted manifest (R7C.1). card_count is authoritative; cards enumerates each with its scope reason.",
      "properties": {
        "card_count": { "type": "integer", "minimum": 0 },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "reason"],
            "properties": {
              "card_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "reason": {
                "enum": ["new", "quarantined-new", "renamed", "bytes-changed"],
                "description": "The worklist header's per-card scope reason (R7C.1)."
              },
              "doc_id": { "type": "string", "maxLength": 64, "pattern": "^[A-Z]+(-[A-Z0-9]+)+$", "description": "Optional human document id (e.g. DOW-UAP-D176) for readability." }
            }
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "source"],
      "description": "Page counts from the credential-free PDF fetch (R7C.5). source=partial when one or more fetches fell back to the per-card heuristic.",
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "source": { "enum": ["fetched", "partial", "unavailable"] },
        "by_card": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Optional map of card_id to page count."
        },
        "largest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "pages"],
            "properties": {
              "card_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
              "doc_id": { "type": "string", "maxLength": 64, "pattern": "^[A-Z]+(-[A-Z0-9]+)+$" },
              "pages": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "estimate": { "$ref": "#/$defs/estimate" },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_fetched", "new_failed", "old_fetched", "old_failed"],
      "description": "Outcome of the credential-free byte fetches (R7C.5 new side, R7C.31 old side).",
      "properties": {
        "new_fetched": { "type": "integer", "minimum": 0 },
        "new_failed": { "type": "integer", "minimum": 0 },
        "old_fetched": { "type": "integer", "minimum": 0 },
        "old_failed": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "side", "reason"],
            "properties": {
              "card_id": { "type": "string" },
              "side": { "enum": ["new", "old"] },
              "reason": { "enum": ["new_fetch_failed", "old_fetch_failed", "old_sha_mismatch"] }
            }
          }
        }
      }
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "poll_run_id": { "type": ["integer", "null"] },
        "poll_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "new_card_id",
        "old_card_id",
        "byte_verdict",
        "byte_verdict_reason",
        "stop_and_ask",
        "recommended_disposition"
      ],
      "properties": {
        "kind": {
          "enum": ["rename-candidate", "quarantine"],
          "description": "The classifier's class for this row: a confirmed rename candidate, or a quarantined new card that collides on continuity signals with an existing card."
        },
        "new_card_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "old_card_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]{16}$" },
        "new_title": { "type": "string", "maxLength": 512 },
        "old_title": { "type": "string", "maxLength": 512 },
        "continuity_signals": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "maxLength": 256 },
          "description": "Why the classifier paired the new card with the old one (e.g. same agency + incident_date, matching numeric id)."
        },
        "old_byte_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "new_byte_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "old_byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "new_byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "byte_verdict": {
          "enum": ["metadata-only", "content-changed", null],
          "description": "classify_bytes result (R7C.12). null when the bytes could not be fetched or did not match the registry; byte_verdict_reason then names the cause and the card forces stop-and-ask."
        },
        "byte_verdict_reason": {
          "enum": [null, "new_fetch_failed", "old_fetch_failed", "old_sha_mismatch"],
          "description": "null when byte_verdict is non-null."
        },
        "evidence": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Present when byte_verdict is non-null. The concrete byte evidence behind the verdict (R7C.12).",
          "properties": {
            "old_prefix_of_new": { "type": "boolean" },
            "appended_bytes": { "type": "integer", "minimum": 0 },
            "incremental_update": { "type": "boolean" },
            "changed_objects": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
            "text_layer_identical": { "type": "boolean" },
            "render_identical": { "type": "boolean" },
            "render_dpi": { "type": "integer", "minimum": 1 }
          }
        },
        "stop_and_ask": {
          "type": "boolean",
          "description": "true when the operator must rule before any spend (byte_verdict null, or content-changed on a quarantine)."
        },
        "recommended_disposition": {
          "enum": [
            "approve-rename-metadata-only-resave",
            "approve-rename",
            "operator-rule-required"
          ],
          "description": "The hand-off's recommendation. metadata-only-resave is accepted by ingest approve without --approve-rename (R7C.12)."
        }
      }
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "partial",
        "judge_figure_label",
        "cap_margin",
        "low_usd",
        "high_usd",
        "recommended_cap_usd",
        "per_stage"
      ],
      "description": "The page-counted, every-stage estimate (R7C.5). low from observed per-page costs, high from each stage's gate ceiling, recommended_cap_usd = ceil(low_usd * (1 + cap_margin)) and strictly below high_usd. All figures USD.",
      "properties": {
        "basis": { "enum": ["page-counted", "per-card-fallback"] },
        "partial": { "type": "boolean", "description": "true when one or more fetches fell back to the per-card heuristic." },
        "judge_figure_label": {
          "enum": ["metered", "table-estimate"],
          "description": "metered when the committed clean-qc bundle carries metered_judge_spend_usd / metered_judge_calls (R7C.6); table-estimate otherwise."
        },
        "cap_margin": { "type": "number", "minimum": 0, "description": "rates.py CAP_MARGIN; 0.5 at design time." },
        "low_usd": { "type": "number", "minimum": 0 },
        "high_usd": { "type": "number", "minimum": 0 },
        "recommended_cap_usd": { "type": "number", "minimum": 0 },
        "fallback_cards": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string" },
          "description": "Cards whose page count fell back to the per-card heuristic."
        },
        "per_stage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "low_rate_per_page", "high_rate_per_page", "low_usd", "high_usd"],
            "properties": {
              "stage": { "enum": ["ocr", "clean", "judge", "embed"] },
              "low_rate_per_page": { "type": "number", "minimum": 0 },
              "high_rate_per_page": { "type": "number", "minimum": 0 },
              "low_usd": { "type": "number", "minimum": 0 },
              "high_usd": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "operator_message": {
      "type": "object",
      "additionalProperties": false,
      "description": "The payload the hand-off driver (R7C.33) emits to the notification relay. rendered_text is the human-readable body; the structured fields let the relay format it and let a test assert its contents.",
      "required": [
        "schema_version",
        "tranche_sha12",
        "subject",
        "diff_summary",
        "verdicts",
        "estimate",
        "gates",
        "brief_path",
        "session",
        "rendered_text"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tranche_sha12": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "subject": { "type": "string" },
        "status": { "enum": ["ready", "stop-and-ask"] },
        "diff_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rows_before", "rows_after", "new_content", "renames", "quarantined", "removed", "field_only"],
          "properties": {
            "rows_before": { "type": "integer", "minimum": 0 },
            "rows_after": { "type": "integer", "minimum": 0 },
            "new_content": { "type": "integer", "minimum": 0 },
            "renames": { "type": "integer", "minimum": 0 },
            "quarantined": { "type": "integer", "minimum": 0 },
            "removed": { "type": "integer", "minimum": 0 },
            "field_only": { "type": "integer", "minimum": 0 }
          }
        },
        "verdicts": {
          "type": "array",
          "description": "One line per rename/quarantine candidate, with the evidence and recommendation the operator rules on.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["card_id", "kind", "verdict", "evidence_line", "recommended"],
            "properties": {
              "card_id": { "type": "string" },
              "doc_id": { "type": "string", "maxLength": 64, "pattern": "^[A-Z]+(-[A-Z0-9]+)+$" },
              "kind": { "enum": ["rename-candidate", "quarantine"] },
              "verdict": { "enum": ["metadata-only", "content-changed", "unknown"] },
              "evidence_line": { "type": "string" },
              "recommended": { "type": "string" }
            }
          }
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pages", "low_usd", "high_usd", "recommended_cap_usd", "judge_figure_label"],
          "properties": {
            "pages": { "type": "integer", "minimum": 0 },
            "low_usd": { "type": "number", "minimum": 0 },
            "high_usd": { "type": "number", "minimum": 0 },
            "recommended_cap_usd": { "type": "number", "minimum": 0 },
            "judge_figure_label": { "enum": ["metered", "table-estimate"] },
            "partial": { "type": "boolean" }
          }
        },
        "gates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Exactly two gates: spend then deploy. Each carries the exact replies that answer it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "prompt", "reply_grant", "reply_deny"],
            "properties": {
              "id": { "enum": ["spend", "deploy"] },
              "prompt": { "type": "string" },
              "reply_grant": { "type": "string" },
              "reply_deny": { "type": "string" },
              "reply_adjust": { "type": "string" }
            }
          }
        },
        "brief_path": { "type": "string" },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["launched"],
          "properties": {
            "launched": { "type": "boolean" },
            "session_ref": { "type": ["string", "null"] },
            "liveness_path": { "type": ["string", "null"] }
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tranche_issue_url": { "type": "string" },
            "diff_receipt_path": { "type": "string" },
            "record_path": { "type": "string" }
          }
        },
        "rendered_text": { "type": "string" }
      }
    }
  }
}
