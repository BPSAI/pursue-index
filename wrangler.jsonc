// Cloudflare Workers + Static Assets configuration.
//
// `main` is the Worker that dispatches /api/retrieve and /api/chat to the
// chat-interface handlers in worker/retrieve.js + worker/chat.js. All other
// paths fall through to static assets.
//
// Static + dynamic both deploy as one project.
//
// Build pipeline (configured in the CF Workers Builds wizard):
//   build:  cd web && npm install && npm run build
//   deploy: npx wrangler deploy
// Fallback CI: `.github/workflows/deploy-cf.yml` runs the same deploy
// from GH Actions on push-to-main when CF Workers Builds stalls.
//
// Required secrets (set with `wrangler secret put NAME`):
//   VOYAGE_API_KEY      — Voyage embeddings (input_type=query) for retrieve
//   ANTHROPIC_API_KEY   — anonymous-tier chat; never leaves the Worker
//
// Required KV namespace binding:
//   CHAT_KV             — rate limit + semantic cache + daily budget
//
// Create the KV namespace first:
//   wrangler kv namespace create CHAT_KV
// Then set the returned id below in `kv_namespaces`.
//
// Required R2 bucket binding:
//   PDFS                — corpus PDFs served same-origin via
//                         /pdf/<card_id>.pdf (see worker/pdf.js). Bucket
//                         name `pursue-pdfs`, key format `<card_id>.pdf`.
//                         The operator must create the bucket via the CF
//                         dashboard and upload the corpus separately;
//                         the binding name `PDFS` is load-bearing for
//                         worker/pdf.js::serveR2Pdf.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pursue-index",
  "compatibility_date": "2026-05-08",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "ef53469e68c04c539cd758b0cf8f1ad8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "pursue-pdfs"
    }
  ],
  "observability": {
    "enabled": true
  }
}
