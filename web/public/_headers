# Cloudflare Pages / Workers static-asset cache headers.
#
# Sprint 2 perf-pass (2026-05-16): the homepage's Lighthouse LCP was
# 12.7–13.1s in APAC + Finland because the 7.1 MB pages.json wasn't
# warming the regional CF edge cache. With no explicit Cache-Control,
# the assets binding emits a short TTL and the regional edges had to
# round-trip to origin on every cold hit.
#
# Order matters here: more specific rules first. Trailing-slash matches
# the path prefix; `*` is a path-segment wildcard.
#
# Verify after deploy with:
#   curl -sI https://pursueindex.com/_astro/<any>.js | grep -i cache-control
#   curl -sI https://pursueindex.com/data/pages.json   | grep -i cache-control

# ---------------------------------------------------------------------
# /_astro/* — Astro emits content-hashed filenames, so these are
# safe to cache forever. `immutable` tells the browser not to
# revalidate when a user hits refresh.
# ---------------------------------------------------------------------
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------------
# /data/* — JSON payloads (pages.json, novelty.json, embed_index.json,
# atlas-layout.json, snapshot diffs). Filenames are NOT content-hashed
# but the content rolls forward in lockstep with each tranche
# deploy. 1-hour TTL covers most user sessions and balances against
# the 30-minute upstream poll cadence; SWR window of 24h lets the
# edge serve stale while it revalidates in the background.
# ---------------------------------------------------------------------
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ---------------------------------------------------------------------
# Embeddings binary blob — same TTL policy as /data/*, but called out
# explicitly because it's the largest single static asset (8.1 MB)
# and worth eyeballing in cache audits.
# ---------------------------------------------------------------------
/data/embeddings.bin
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ---------------------------------------------------------------------
# /thumbs/* and /og/* — generated card thumbnails + per-card OG cards.
# Names are derived from card_id (stable per tranche). 1-week TTL with
# SWR is plenty; if a tranche replaces an image, the next deploy
# invalidates via the assets-binding deploy.
# ---------------------------------------------------------------------
/data/thumbs/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/data/video-posters/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# ---------------------------------------------------------------------
# Top-level static images — favicon + the bundled OG card.
# ---------------------------------------------------------------------
/og.png
  Cache-Control: public, max-age=604800
/og.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800

# ---------------------------------------------------------------------
# GEO surfaces (Sprint 1) — llms.txt / llms-full.txt / robots.txt.
# These ship per-deploy (prebuild script regenerates them); 1-hour
# TTL matches the data/* policy. robots.txt is also served as a
# dynamic Astro endpoint at /robots.txt with its own Cache-Control
# header — this rule only fires for the static fallback case.
# ---------------------------------------------------------------------
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
