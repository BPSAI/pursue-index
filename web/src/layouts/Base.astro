---
import "../styles/global.css";
import { manifest } from "../data/manifest-loader";
import JsonLd from "../components/JsonLd.astro";
import {
  organizationJsonLd,
  websiteJsonLd,
  datasetJsonLd,
  type JsonLdObject,
} from "../lib/seo";
import { RELEASE } from "../lib/release";

interface Props {
  title?: string;
  description?: string;
  active?: "index" | "search" | "chat" | "diff" | "removed" | "about" | "methodology" | "cite" | "support" | "finds" | "atlas" | "gallery" | null;
  /**
   * Pre-launch: every page is noindex/nofollow until we flip the default.
   * FIXME(launch): flip noindex default to false once we're ready for SE indexing.
   */
  noindex?: boolean;
  /**
   * Optional override for the OG image; defaults to /og.png.
   *
   * Must be either an absolute URL whose origin matches `siteOrigin`
   * (i.e. `https://pursueindex.com/...`) OR a root-relative path
   * starting with a single `/`. Protocol-relative (`//cdn...`) and
   * bare relative paths are rejected — they break absolute-URL
   * resolution and let an attacker who controls the prop point
   * scrapers at an arbitrary host (SEC-002 hardening).
   */
  ogImage?: string;
  /** Optional alt text for the OG/Twitter image. Same value used in both. */
  ogImageAlt?: string;
  /** OG type — "website" by default; "article" for individual finds entries. */
  ogType?: "website" | "article";
  /**
   * Page-specific JSON-LD schemas (DigitalDocument, Article,
   * BreadcrumbList, Speakable, etc.). Rendered alongside the
   * site-wide Organization / WebSite / Dataset blocks. Pass a single
   * object or an array.
   */
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const DEFAULT_OG_IMAGE_ALT =
  "PURSUE://INDEX — DOW PURSUE UAP Document Archive — declassified document card with PURSUE://INDEX wordmark and corpus stats";

const {
  title = "PURSUE://INDEX",
  description = "Searchable archive of the U.S. Department of War PURSUE UAP document releases.",
  active = null,
  noindex = false,
  ogImage,
  ogImageAlt = DEFAULT_OG_IMAGE_ALT,
  ogType = "website",
  jsonLd,
} = Astro.props;

// Site-wide JSON-LD blocks (rendered on every page): Organization +
// WebSite (with SearchAction) + Dataset. Per Sprint 1 GEO foundation.
// Page-specific schemas (DigitalDocument, Article, BreadcrumbList,
// Speakable) come in via the `jsonLd` prop and are appended below.
const siteJsonLd: JsonLdObject[] = [
  organizationJsonLd(),
  websiteJsonLd(),
  datasetJsonLd({
    cardCount: RELEASE.cardCount,
    ocrPageCount: RELEASE.ocrPageCount,
    lastTrancheDate: RELEASE.lastTrancheDate,
    release01Date: RELEASE.release01Date,
  }),
];
const pageJsonLd: JsonLdObject[] = jsonLd
  ? Array.isArray(jsonLd) ? jsonLd : [jsonLd]
  : [];
const allJsonLd: JsonLdObject[] = [...siteJsonLd, ...pageJsonLd];

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteOrigin = Astro.site ? Astro.site.origin : "https://pursueindex.com";
const canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalUrl = `${siteOrigin}${canonicalPath}`;

// Validate ``ogImage`` shape at build time. Anything unexpected is a
// hard error rather than a silent malformed meta tag — see SEC-002.
function resolveOgImageUrl(raw: string | undefined): string {
  if (!raw) return `${siteOrigin}${base}/og.png`;
  if (/^https?:\/\//.test(raw)) {
    if (!raw.startsWith(`${siteOrigin}/`) && raw !== siteOrigin) {
      throw new Error(
        `Invalid ogImage: cross-origin URL ${JSON.stringify(raw)} not allowed. Must start with ${siteOrigin}/ or be root-relative.`,
      );
    }
    return raw;
  }
  // Reject protocol-relative ("//cdn.example.com/x.png") and bare
  // relative paths ("og.png" without a leading slash).
  if (raw.startsWith("//") || !raw.startsWith("/")) {
    throw new Error(
      `Invalid ogImage: ${JSON.stringify(raw)} must be an absolute URL on ${siteOrigin} or a root-relative path beginning with '/'.`,
    );
  }
  return `${siteOrigin}${raw}`;
}

const ogImageUrl = resolveOgImageUrl(ogImage);
// Derive the MIME type from the resolved URL so per-route JPEG/WebP
// overrides are labeled correctly (Codex P2). Defaults to image/png
// for the bundled card.
const _ogImageExt = ogImageUrl.split("?")[0].split("#")[0].toLowerCase().split(".").pop() ?? "png";
const ogImageType =
  _ogImageExt === "jpg" || _ogImageExt === "jpeg"
    ? "image/jpeg"
    : _ogImageExt === "webp"
      ? "image/webp"
      : _ogImageExt === "gif"
        ? "image/gif"
        : "image/png";

// Cloudflare Web Analytics beacon token. CF Pages auto-injects this
// via HTML rewriter on traditional Pages deploys, but Workers Static
// Assets (our deploy path) bypasses that injection — SEOPTIMER
// detected "Cloudflare Browser Insights" via tech fingerprint while
// view-source on the deployed HTML showed no script tag, confirming
// the gap. Sprint 4a (2026-05-17) wires the beacon explicitly. The
// token is read from PUBLIC_CF_ANALYTICS_TOKEN at build time; the
// CSP already allows static.cloudflareinsights.com (script-src) and
// cloudflareinsights.com (connect-src) — see worker/index.js.
//
// Operator action required: set PUBLIC_CF_ANALYTICS_TOKEN in CF
// Pages → Settings → Environment variables, sourced from CF →
// Analytics & Logs → Web Analytics → site token. Until set, the
// beacon script is skipped (token-conditional render below).
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;

const fetchedISO = manifest.fetched_at;
const fetchedDate = new Date(fetchedISO).toISOString().slice(0, 19).replace("T", " ");
const sha = manifest.csv_sha256.slice(0, 12);
const cardCount = manifest.cards.length;

const navItems = [
  { href: `${base}/`, label: "INDEX", key: "index" },
  { href: `${base}/search`, label: "SEARCH", key: "search" },
  { href: `${base}/chat`, label: "CHAT", key: "chat" },
  { href: `${base}/finds`, label: "FINDS", key: "finds" },
  { href: `${base}/gallery`, label: "GALLERY", key: "gallery" },
  { href: `${base}/atlas`, label: "ATLAS", key: "atlas" },
  { href: `${base}/timeline`, label: "TIMELINE", key: "timeline" },
  { href: `${base}/diff`, label: "DIFF", key: "diff" },
  { href: `${base}/removed`, label: "REMOVED", key: "removed" },
  { href: `${base}/about`, label: "ABOUT", key: "about" },
  { href: `${base}/methodology`, label: "METHODOLOGY", key: "methodology" },
  { href: `${base}/cite`, label: "CITE", key: "cite" },
  { href: `${base}/support`, label: "SUPPORT", key: "support" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d12" />

    {/* FIXME(launch): flip noindex default to false in Base.astro Props */}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PURSUE://INDEX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {/* twitter:site / twitter:creator deferred — no BPS X/Twitter handle yet.
        When one lands, add: <meta name="twitter:site" content="@..." /> */}

    {/* JSON-LD schemas — site-wide + page-specific. See web/src/lib/seo.ts
        and the Sprint 1 GEO foundation plan. */}
    <JsonLd data={allJsonLd} />

    {/* Cloudflare Web Analytics — Sprint 4a (2026-05-17). Workers
        Static Assets bypasses CF Pages' HTML-rewriter beacon injection,
        so we wire it explicitly. Token-conditional: skipped when
        PUBLIC_CF_ANALYTICS_TOKEN is unset (local dev, preview builds
        without the env var). `defer` keeps the beacon off the LCP
        critical path. */}
    {cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
      ></script>
    )}

    <title>{title}</title>
  </head>
  <body class="terminal min-h-screen flex flex-col">
    {/* Skip to main content — WCAG 2.4.1. Hidden until keyboard focus,
        then renders at top-left as a signal-green pill. The anchor target
        ``#main`` is the <main> element below. Without this, a keyboard
        user has to tab through the entire 12-link nav on every page. */}
    <a href="#main" class="pi-skip-link sr-only-focusable">Skip to main content</a>

    {/* Top scan line — decorative; aria-hidden so screen readers don't
        announce it as a separator. */}
    <div aria-hidden="true" class="h-px w-full bg-[color:var(--color-signal-green)]/30 shadow-[0_0_8px_rgba(164,255,90,0.4)]"></div>

    <header class="sticky top-0 z-30 border-b border-[color:var(--color-border)] bg-[color:var(--color-bg-deep)]/85 backdrop-blur-sm">
      {/* On mobile, the nav wraps below the lockup; on lg, both share one row.
          Without flex-wrap the long uppercase nav overflowed at 375px. */}
      <div class="mx-auto max-w-7xl px-4 py-3 flex flex-col gap-2 lg:flex-row lg:items-center lg:gap-6">
        <div class="flex items-center justify-between gap-3">
          <a href={`${base}/`} class="group inline-flex items-baseline font-mono text-sm tracking-tight">
            <span class="text-[color:var(--color-text-dim)]">PURSUE</span>
            <span class="text-[color:var(--color-signal-green)] mx-0.5">://</span>
            <span class="text-[color:var(--color-text-bright)] font-semibold group-hover:text-[color:var(--color-signal-green)] transition-colors">INDEX</span>
            <span class="pi-caret"></span>
          </a>
          {/* Mobile-only research-preview badge — sits next to the lockup so
              the wrapping nav row reads cleanly below. Bracketed terminal
              styling mirrors the desktop badge; targets the methodology
              page's #research-preview anchor for the one-paragraph
              disclosure of what "research preview" means in practice
              (placeholder novelty corpus, editorial coverage in flux). */}
          <a
            href={`${base}/methodology#research-preview`}
            title="What 'research preview' means"
            class="lg:hidden inline-flex items-center px-1.5 py-0.5 rounded-sm border border-[color:var(--color-signal-amber)]/40 bg-[color:var(--color-signal-amber)]/10 text-[10px] font-mono uppercase tracking-[0.12em] text-[color:var(--color-signal-amber)] hover:border-[color:var(--color-signal-amber)] transition-colors"
          >
            [RESEARCH PREVIEW]
          </a>
        </div>

        <nav aria-label="Primary" class="-mx-1 flex flex-wrap items-center gap-x-1 gap-y-1 text-[11px] font-mono uppercase tracking-[0.18em] lg:ml-auto lg:mr-0 lg:flex-nowrap">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-sm transition-colors",
                active === item.key
                  ? "text-[color:var(--color-signal-green)] bg-[color:var(--color-signal-green)]/10"
                  : "text-[color:var(--color-text-dim)] hover:text-[color:var(--color-text-bright)]",
              ]}
            >{item.label}</a>
          ))}
          {/* Desktop research-preview badge — terminal-style bracketed
              label sitting at the end of the nav row. Links to the
              methodology page's #research-preview anchor where the
              calibration surfaces (placeholder novelty corpus,
              editorial coverage, OCR confidence) are disclosed up front. */}
          <a
            href={`${base}/methodology#research-preview`}
            title="What 'research preview' means"
            class="ml-2 hidden lg:inline-flex items-center px-1.5 py-0.5 rounded-sm border border-[color:var(--color-signal-amber)]/40 bg-[color:var(--color-signal-amber)]/10 text-[10px] font-mono uppercase tracking-[0.12em] text-[color:var(--color-signal-amber)] hover:border-[color:var(--color-signal-amber)] transition-colors"
          >
            [RESEARCH PREVIEW]
          </a>
          <a
            href="https://github.com/BPSAI/pursue-index"
            target="_blank"
            rel="noreferrer"
            aria-label="Project repository on GitHub (opens in new tab)"
            class="ml-1 lg:ml-2 px-2 py-1 rounded-sm text-[color:var(--color-text-dim)] hover:text-[color:var(--color-signal-cyan)] transition-colors"
          >GH</a>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1" class="flex-1 mx-auto w-full max-w-7xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-[color:var(--color-border)] bg-[color:var(--color-bg-deep)]">
      {/* Provenance / metadata row — TS, CSV_SHA256, N are load-bearing
          for citation reproducibility. SRC + IDX establish copyright + license. */}
      <div class="mx-auto max-w-7xl px-4 pt-5 pb-3 text-[11px] font-mono text-[color:var(--color-text-dim)] flex flex-wrap gap-x-6 gap-y-2 sm:justify-between">
        <span>
          <span class="text-[color:var(--color-text-faint)]">TS</span>
          <span class="ml-2 text-[color:var(--color-text)]">{fetchedDate}Z</span>
        </span>
        <span>
          <span class="text-[color:var(--color-text-faint)]">CSV_SHA256</span>
          <span class="ml-2 text-[color:var(--color-signal-cyan)]">{sha}</span>
        </span>
        <span>
          <span class="text-[color:var(--color-text-faint)]">N</span>
          <span class="ml-2 text-[color:var(--color-text)]">{cardCount}</span>
        </span>
        <span>
          <span class="text-[color:var(--color-text-faint)]">SRC</span>
          <span class="ml-2">U.S.G. WORK / PUBLIC DOMAIN</span>
        </span>
        <span>
          <span class="text-[color:var(--color-text-faint)]">IDX</span>
          <a
            href="https://bpsaisoftware.com"
            target="_blank"
            rel="noreferrer"
            class="ml-2 hover:text-[color:var(--color-signal-cyan)] transition-colors"
          >© BPS AI SOFTWARE</a>
          <span class="mx-1 text-[color:var(--color-text-faint)]">·</span>
          <a href={`${base}/cite`} class="hover:text-[color:var(--color-signal-cyan)] transition-colors">APACHE-2.0</a>
        </span>
        <span>
          <span class="text-[color:var(--color-text-faint)]">API</span>
          <a href={`${base}/api`} class="ml-2 hover:text-[color:var(--color-signal-cyan)] transition-colors">/api</a>
        </span>
      </div>
      {/* Credit row — Powered by PairCoder, paired with the BPS link above. */}
      <div class="mx-auto max-w-7xl px-4 pb-5 text-[10px] font-mono uppercase tracking-[0.18em] text-[color:var(--color-text-faint)] flex flex-wrap gap-x-3 gap-y-1 items-center">
        <span>POWERED BY</span>
        <a
          href="https://paircoder.ai"
          target="_blank"
          rel="noreferrer"
          class="text-[color:var(--color-signal-green)] hover:text-[color:var(--color-text-bright)] transition-colors"
        >PAIRCODER</a>
        <span>·</span>
        <span>AI-AUGMENTED PAIR PROGRAMMING</span>
      </div>
    </footer>
  </body>
</html>
