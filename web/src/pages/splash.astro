---
import "../styles/global.css";
import { manifest } from "../data/manifest-loader";

const fetchedDate = new Date(manifest.fetched_at).toISOString().slice(0, 10);
const sha = manifest.csv_sha256.slice(0, 16);
const cardCount = manifest.cards.length;

const pageTitle = "PURSUE://INDEX — research preview";
const description =
  "A searchable, citable interface to the U.S. Department of War's PURSUE UAP document releases. Launching soon.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://pursueindex.com/" />
    <meta property="og:image" content="https://pursueindex.com/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pursueindex.com/og.png" />

    <title>{pageTitle}</title>
  </head>
  <body class="terminal min-h-screen flex flex-col">
    {/* Top scan line */}
    <div class="h-px w-full bg-[color:var(--color-signal-green)]/30 shadow-[0_0_8px_rgba(164,255,90,0.4)]"></div>

    <main class="flex-1 mx-auto w-full max-w-3xl px-6 py-16 sm:py-24 flex flex-col">
      {/* Lockup */}
      <header class="space-y-2 mb-12">
        <div class="font-mono text-[11px] uppercase tracking-[0.25em] text-[color:var(--color-signal-green)] flex items-center gap-2">
          <span class="text-[color:var(--color-text-faint)]">$</span>
          <span>uname -n</span>
        </div>
        <h1 class="font-mono text-3xl sm:text-4xl font-semibold tracking-tight inline-flex items-baseline">
          <span class="text-[color:var(--color-text-dim)]">PURSUE</span>
          <span class="text-[color:var(--color-signal-green)] mx-1">://</span>
          <span class="text-[color:var(--color-text-bright)]">INDEX</span>
          <span class="pi-caret"></span>
        </h1>
        <p class="font-mono text-sm uppercase tracking-[0.18em] text-[color:var(--color-text-dim)]">
          DOW UAP DOCUMENT ARCHIVE · RESEARCH PREVIEW
        </p>
      </header>

      {/* Status block */}
      <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 pi-bracket relative scanlines-soft mb-10">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-signal-amber)] mb-3">
          [SYSTEM] RECON IN PROGRESS
        </div>
        <table class="font-mono text-sm w-full">
          <tbody>
            <tr>
              <td class="text-[color:var(--color-text-faint)] py-1 pr-6">CARDS</td>
              <td class="text-[color:var(--color-text-bright)]">{cardCount}</td>
            </tr>
            <tr>
              <td class="text-[color:var(--color-text-faint)] py-1 pr-6">AGENCIES</td>
              <td class="text-[color:var(--color-text-bright)]">4 · DOW · FBI · NASA · DOS</td>
            </tr>
            <tr>
              <td class="text-[color:var(--color-text-faint)] py-1 pr-6">PAGES OCR'D</td>
              <td class="text-[color:var(--color-text-bright)]">4,153</td>
            </tr>
            <tr>
              <td class="text-[color:var(--color-text-faint)] py-1 pr-6">CSV SNAPSHOT</td>
              <td class="text-[color:var(--color-signal-cyan)]">{sha} <span class="text-[color:var(--color-text-faint)]">@</span> {fetchedDate}</td>
            </tr>
            <tr>
              <td class="text-[color:var(--color-text-faint)] py-1 pr-6">SOURCE</td>
              <td class="text-[color:var(--color-text)]">U.S.G. WORK / PUBLIC DOMAIN</td>
            </tr>
          </tbody>
        </table>
      </section>

      {/* Mission */}
      <section class="space-y-4 text-sm leading-relaxed text-[color:var(--color-text)] mb-12">
        <p>
          The U.S. Department of War publishes the
          <em class="text-[color:var(--color-text-bright)]">Presidential Unsealing and Reporting System for UAP Encounters</em>
          as a single CSV that gets updated in place. PURSUE://INDEX is the public, citable
          interface to that corpus.
        </p>
        <p>
          Built to ground every claim in the source documents, abstain when the corpus
          doesn't support a finding, and tag novel disclosures vs. material that has
          circulated in prior FOIA archives for years.
        </p>
      </section>

      {/* Coming online */}
      <section class="mb-12">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-4 flex items-center gap-2">
          <span class="text-[color:var(--color-signal-green)]">▸</span> COMING ONLINE
        </h2>
        <ul class="space-y-2 font-mono text-sm">
          <li class="flex items-start gap-3">
            <span class="text-[color:var(--color-signal-green)] mt-0.5">▪</span>
            <span class="text-[color:var(--color-text)]">
              full-text search across every OCR'd page
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[color:var(--color-signal-green)] mt-0.5">▪</span>
            <span class="text-[color:var(--color-text)]">
              AI-driven semantic exploration (RAG with mandatory citations · BYOK supported)
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[color:var(--color-signal-green)] mt-0.5">▪</span>
            <span class="text-[color:var(--color-text)]">
              <span class="text-[color:var(--color-signal-amber)]">novel vs. previously disclosed</span>
              tagging vs. The Black Vault and other FOIA archives
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[color:var(--color-signal-green)] mt-0.5">▪</span>
            <span class="text-[color:var(--color-text)]">
              hand-curated reading guides authored from the source documents
            </span>
          </li>
        </ul>
      </section>

      {/* CTA / footer */}
      <footer class="mt-auto pt-8 border-t border-[color:var(--color-border)] flex flex-wrap gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-dim)]">
        <a
          href="https://github.com/BPSAI/pursue-index"
          target="_blank"
          rel="noreferrer"
          class="hover:text-[color:var(--color-signal-cyan)]"
        >github.com/BPSAI/pursue-index</a>
        <span class="text-[color:var(--color-text-faint)]">·</span>
        <span>© BPS AI Software</span>
        <span class="ml-auto text-[color:var(--color-text-faint)]">// preview access available with valid token</span>
      </footer>
    </main>

    {/* Bottom scan line */}
    <div class="h-px w-full bg-[color:var(--color-signal-green)]/20"></div>
  </body>
</html>
