---
import Base from "../../layouts/Base.astro";
import CardOcrIsland from "../../components/CardOcrIsland.tsx";
import CardProvenance from "../../components/CardProvenance.tsx";
import AgencyStamp from "../../components/AgencyStamp.astro";
import { cards } from "../../data/manifest-loader";
import {
  digitalDocumentJsonLd,
  breadcrumbJsonLd,
  SITE_ORIGIN,
} from "../../lib/seo";
// Native ES imports for build-time data (matches diff.astro + the
// timeline.astro fix on 2026-05-15; the readFileSync pattern was
// unreliable on the Cloudflare Pages build context).
import cardAltTitlesJson from "../../../../data/card_alt_titles.json";
import displayDatesJson from "../../../../data/display_dates.json";

// Page-1 OCR text snippet for the DigitalDocument JSON-LD body. Read
// once at module-evaluation time from pages.json via fs (not ES
// import — pages.json is ~7MB and would bloat every card page's
// build artifact otherwise). The lookup is built once per build and
// shared across all card pages emitted by getStaticPaths.
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, resolve } from "node:path";

interface OcrPage {
  card_id: string;
  page: number;
  text: string;
}

function loadFirstPageByCard(): Record<string, string> {
  const here = dirname(fileURLToPath(import.meta.url));
  // web/src/pages/card/[card_id].astro → web/public/data/pages.json
  const path = resolve(here, "../../../public/data/pages.json");
  let text: string;
  try {
    text = readFileSync(path, "utf8");
  } catch {
    return {};
  }
  const rows = JSON.parse(text) as OcrPage[];
  const byCard: Record<string, string> = {};
  for (const row of rows) {
    if (!row || typeof row.text !== "string") continue;
    const existing = byCard[row.card_id];
    // Keep the lowest page number's text per card (page 1 if present).
    if (existing === undefined || row.page === 1) {
      byCard[row.card_id] = row.text;
    }
  }
  return byCard;
}
const firstPageTextByCard = loadFirstPageByCard();

// Alt-titles for cards that share asset_url with other rows upstream
// (the 9-card cohort from duplicate-card-ids-discovery). When
// present, the card detail page surfaces "Also cataloged upstream
// as:" so readers see the cross-references upstream maintains.
interface AltTitleEntry {
  title: string;
  dvids_video_id: string | null;
  asset_filename: string | null;
}
const altsByCardId: Record<string, AltTitleEntry[]> = (cardAltTitlesJson as any).alts ?? {};

// Curated display-date overlay. Operator-approved entries in
// data/display_dates.json override the manifest's incident_date for
// editorial accuracy (e.g. when the manifest carries 9/12/03 but the
// document body has a 2023 Zulu DTG, the curated date wins).
interface DisplayDateEntry {
  card_id: string;
  display_date?: string | null;
  display_date_range?: [string, string] | null;
  display_date_evidence?: string | null;
  display_date_evidence_card_ref?: string | null;
  display_date_abstention?: string | null;
  display_date_curator?: string | null;
  display_date_approved_at?: string | null;
}
const displayDateByCardId: Record<string, DisplayDateEntry> = Object.fromEntries(
  ((displayDatesJson as any).entries ?? []).map((e: DisplayDateEntry) => [e.card_id, e]),
);

export function getStaticPaths() {
  return cards.map((c) => ({
    params: { card_id: c.card_id },
    props: { card: c },
  }));
}

const { card } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const altTitles: AltTitleEntry[] = altsByCardId[card.card_id] ?? [];
const displayDateEntry: DisplayDateEntry | null = displayDateByCardId[card.card_id] ?? null;
// When a curated display_date exists, surface it as the primary
// INCIDENT line; preserve the manifest's raw CSV value as a muted
// sub-line so the override is auditable. When the curated entry is
// an abstention, surface the abstention reason instead of a date.
const curatedIncidentDate = displayDateEntry?.display_date ?? null;
const curatedAbstention = displayDateEntry?.display_date_abstention ?? null;

const TYPE_COLORS: Record<string, { fg: string; bg: string; border: string }> = {
  PDF: {
    fg: "text-[color:var(--color-signal-red)]",
    bg: "bg-[color:var(--color-signal-red)]/10",
    border: "border-[color:var(--color-signal-red)]/40",
  },
  IMG: {
    fg: "text-[color:var(--color-signal-green)]",
    bg: "bg-[color:var(--color-signal-green)]/10",
    border: "border-[color:var(--color-signal-green)]/40",
  },
  VID: {
    fg: "text-[color:var(--color-signal-violet)]",
    bg: "bg-[color:var(--color-signal-violet)]/10",
    border: "border-[color:var(--color-signal-violet)]/40",
  },
};
const tc = TYPE_COLORS[card.asset_type] ?? TYPE_COLORS.PDF;

const pairings = [
  card.pdf_pairing ? { label: "PDF pairing", value: card.pdf_pairing } : null,
  card.video_pairing ? { label: "Video pairing", value: card.video_pairing } : null,
].filter((p): p is { label: string; value: string } => p !== null);

// INCIDENT line uses the curated display_date when present; the
// manifest's raw incident_date is preserved as a sub-line in the
// fact-grid renderer when the two disagree. The curated value is
// what /timeline plots and what citations should reference.
const incidentLineValue: string | null = curatedIncidentDate
  ? curatedIncidentDate
  : curatedAbstention
    ? "(undated — see provenance)"
    : card.incident_date;

interface Fact {
  label: string;
  value: string | null;
  // Optional muted sub-line (e.g. the manifest's raw CSV value when
  // we're overriding it with a curated display_date).
  subValue?: string | null;
}

const facts: Fact[] = [
  { label: "RELEASE", value: card.release_date },
  {
    label: "INCIDENT",
    value: incidentLineValue,
    subValue:
      curatedIncidentDate && card.incident_date && curatedIncidentDate !== card.incident_date
        ? `manifest CSV value: ${card.incident_date} (overridden by curated display_date)`
        : null,
  },
  { label: "LOCATION", value: card.incident_location },
  { label: "TYPE", value: card.asset_type },
];

const isPdf = card.asset_type === "PDF" && !!card.asset_url;
const isVideo = card.asset_type === "VID" && !!card.dvids_video_id;
// Sprint 4f: AUD cards share the DVIDS-id field today (the upstream
// CSV uses the same "DVIDS Video ID" column for both video and audio).
// DVIDS itself has a separate /audio/embed/<id> path that points at
// the audio player.
const isAudio = card.asset_type === "AUD" && !!card.dvids_video_id;
const pageTitle = `${card.title.slice(0, 60)}${card.title.length > 60 ? "…" : ""} — PURSUE://INDEX`;

// Page-specific JSON-LD: DigitalDocument (with first-page OCR slice)
// + BreadcrumbList. Site-wide Org / WebSite / Dataset come from Base.
const firstPageText = firstPageTextByCard[card.card_id] ?? "";
const cardJsonLd = [
  digitalDocumentJsonLd(card, firstPageText),
  breadcrumbJsonLd([
    { name: "Index", url: "/" },
    { name: "Card", url: `/card/${card.card_id}` },
  ]),
];
---

<Base title={pageTitle} description={card.description ?? card.title} jsonLd={cardJsonLd}>
  <article class="space-y-6">
    {/* Breadcrumb — visual `/` separators are decorative; aria-label
        on the nav makes the landmark discoverable. */}
    <nav aria-label="Breadcrumb" class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)] flex items-center gap-2">
      <a href={`${base}/`} class="hover:text-[color:var(--color-signal-green)]">/INDEX</a>
      <span aria-hidden="true">/</span>
      <span class="text-[color:var(--color-text-dim)]">CARD</span>
      <span aria-hidden="true">/</span>
      <span class="text-[color:var(--color-signal-cyan)]" aria-current="page">{card.card_id.slice(0, 12)}</span>
    </nav>

    {/* Header */}
    <header class="space-y-4 border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 pi-bracket relative scanlines-soft">
      {/* Top row: type/redaction badges (left), agency stamp (right).
          Stack on mobile with stamp centered; align on sm and up. */}
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
        <div class="flex flex-wrap items-center gap-2 min-w-0">
          <span class={`text-[10px] font-mono uppercase tracking-[0.15em] px-1.5 py-0.5 border ${tc.bg} ${tc.fg} ${tc.border}`}>
            {card.asset_type}
          </span>
          <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[color:var(--color-text-dim)]">
            AGENCY · {card.agency}
          </span>
          {card.redacted && (
            <span class="text-[10px] font-mono uppercase tracking-[0.15em] text-[color:var(--color-signal-red)] font-semibold">
              ● REDACTED
            </span>
          )}
        </div>
        <div class="flex justify-center sm:block sm:flex-shrink-0">
          <AgencyStamp agency={card.agency} releaseDate={card.release_date} size="lg" />
        </div>
      </div>

      <h1 class="text-lg sm:text-xl font-semibold leading-snug text-[color:var(--color-text-bright)] break-words">
        {card.title}
      </h1>

      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs pt-2 border-t border-[color:var(--color-border)]">
        {facts.map((f) => (
          <div>
            <dt class="text-[10px] font-mono uppercase tracking-[0.18em] text-[color:var(--color-text-faint)]">{f.label}</dt>
            <dd class="font-mono text-[color:var(--color-text-bright)] mt-0.5">
              {f.value ?? <span class="text-[color:var(--color-text-faint)]">—</span>}
            </dd>
            {f.subValue && (
              <dd class="font-mono text-[9px] text-[color:var(--color-text-faint)] mt-0.5 italic">
                {f.subValue}
              </dd>
            )}
          </div>
        ))}
      </dl>

      <div class="text-[10px] font-mono text-[color:var(--color-text-faint)] break-all pt-2 border-t border-[color:var(--color-border)]">
        <span class="uppercase tracking-[0.18em]">CARD_ID</span>
        <span class="ml-2">{card.card_id}</span>
      </div>
    </header>

    {/* Two-column: PDF preview + sidebar metadata. PDF stacks below on small screens. */}
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_minmax(20rem,22rem)] gap-6">
      {/* Source / preview pane */}
      <section class="space-y-3">
        <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] flex items-center gap-2">
          <span class="text-[color:var(--color-signal-green)]">▸</span> SOURCE
        </h2>

        {isPdf && card.asset_url ? (
          <div class="border border-[color:var(--color-border)] bg-black/60 relative overflow-hidden">
            <div class="absolute top-2 right-2 z-10 flex gap-2 text-[10px] font-mono uppercase tracking-[0.15em]">
              <a
                href={card.asset_url}
                target="_blank"
                rel="noreferrer"
                class="px-2 py-1 bg-[color:var(--color-bg-deep)]/85 border border-[color:var(--color-border)] text-[color:var(--color-signal-cyan)] hover:border-[color:var(--color-signal-cyan)]"
              >OPEN ↗</a>
            </div>
            {/* No `sandbox` attribute on this iframe — intentional, see below.

                Originally (PR #27, laverna SEC-001) we shipped this iframe
                with `sandbox="allow-scripts allow-same-origin"` so a hostile
                PDF could not escape via top-navigation / popups / forms.
                Chrome 147 (May 2026) changed PDFium's iframe behavior:
                ANY value of `sandbox` — even with every allow-* token
                enumerated — now suppresses inline PDF rendering, leaving
                the iframe blank. The PDF viewer plugin will not initialize
                under a sandboxed browsing context. Verified empirically by
                toggling tokens; the attribute itself is the trigger.

                Trust basis for dropping it: after PR #27 this iframe loads
                ONLY `/pdf/<card_id>.pdf`, served same-origin from our own
                R2 mirror (binding PDFS, bucket pursue-pdfs). The URL is
                content-addressed by sha256(asset_url || title); we put the
                bytes there ourselves. The original threat model assumed
                third-party PDF content could end up in this iframe, which
                hasn't been true since #27. CSP `frame-ancestors 'self'`
                + worker `X-Frame-Options: SAMEORIGIN` keep the page from
                being framed by anyone else.

                src: same-origin /pdf/<card_id>.pdf served from R2 via
                worker/pdf.js. OPEN ↗ above still cites card.asset_url
                (war.gov) as source-of-record. */}
            <iframe
              id="card-pdf-iframe"
              data-asset-type={card.asset_type}
              src={`/pdf/${card.card_id}.pdf`}
              title={`PDF source: ${card.title}`}
              referrerpolicy="no-referrer"
              class="w-full h-[60vh] min-h-[420px] sm:h-[80vh] sm:min-h-[640px] bg-[color:var(--color-bg-deep)]"
              loading="lazy"
            ></iframe>
          </div>
        ) : isVideo ? (
          <div class="space-y-2">
            <div class="border border-[color:var(--color-border)] bg-black relative overflow-hidden">
              <iframe
                src={`https://www.dvidshub.net/video/embed/${card.dvids_video_id}`}
                title={`Video: ${card.title}`}
                allowfullscreen
                referrerpolicy="no-referrer"
                class="w-full aspect-video bg-black"
                loading="lazy"
              ></iframe>
            </div>
            <div class="flex flex-wrap gap-3 font-mono text-[11px] uppercase tracking-[0.15em]">
              <a
                href={`https://www.dvidshub.net/video/${card.dvids_video_id}`}
                target="_blank"
                rel="noreferrer"
                class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]"
              >
                Open on DVIDS ↗
              </a>
              <span class="text-[color:var(--color-text-faint)]">
                DVIDS id: <code class="text-[color:var(--color-signal-violet)]">{card.dvids_video_id}</code>
              </span>
            </div>
          </div>
        ) : isAudio ? (
          <div class="space-y-2">
            <div class="border border-[color:var(--color-border)] bg-black relative overflow-hidden">
              <iframe
                src={`https://www.dvidshub.net/audio/embed/${card.dvids_video_id}`}
                title={`Audio: ${card.title}`}
                referrerpolicy="no-referrer"
                class="w-full h-[180px] bg-black"
                loading="lazy"
              ></iframe>
            </div>
            <div class="flex flex-wrap gap-3 font-mono text-[11px] uppercase tracking-[0.15em]">
              <a
                href={`https://www.dvidshub.net/audio/${card.dvids_video_id}`}
                target="_blank"
                rel="noreferrer"
                class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]"
              >
                Open on DVIDS ↗
              </a>
              <span class="text-[color:var(--color-text-faint)]">
                DVIDS id: <code class="text-[color:var(--color-signal-amber)]">{card.dvids_video_id}</code>
              </span>
            </div>
          </div>
        ) : card.modal_image_url && card.asset_type !== "VID" && card.asset_type !== "AUD" ? (
          <div class="border border-[color:var(--color-border)] bg-black/40 p-2 relative scanlines-soft">
            <img
              src={card.modal_image_url}
              alt={card.title}
              class="w-full max-w-full"
              loading="lazy"
            />
          </div>
        ) : card.asset_url ? (
          <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-4">
            <a
              href={card.asset_url}
              target="_blank"
              rel="noreferrer"
              class="font-mono text-sm text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)] break-all"
            >
              {card.asset_filename ?? card.asset_url} <span class="text-[color:var(--color-text-faint)]">↗</span>
            </a>
          </div>
        ) : (
          <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-4 font-mono text-sm text-[color:var(--color-text-dim)]">
            <span class="text-[color:var(--color-signal-amber)]">[NO ASSET URL]</span>
            {card.dvids_video_id && (
              <span class="ml-2">DVIDS id: <code class="text-[color:var(--color-signal-violet)]">{card.dvids_video_id}</code></span>
            )}
          </div>
        )}

        {card.description && (
          <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/40 p-4 mt-4">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-2">
              DESCRIPTION
            </h3>
            <p class="text-sm leading-relaxed text-[color:var(--color-text)] whitespace-pre-wrap">
              {card.description}
            </p>
          </section>
        )}
      </section>

      {/* Sidebar — sections are siblings of SOURCE under the card <h1>,
          so they take h2 to keep the outline flat-and-correct rather
          than skipping a level. */}
      <aside aria-label="Card sidebar" class="space-y-4">
        <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4">
          <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-3">
            ASSET
          </h2>
          {card.asset_url ? (
            <a
              href={card.asset_url}
              target="_blank"
              rel="noreferrer"
              class="font-mono text-xs text-[color:var(--color-signal-cyan)] hover:text-[color:var(--color-text-bright)] break-all block"
            >
              {card.asset_filename ?? card.asset_url}
              <span class="block text-[10px] text-[color:var(--color-text-faint)] mt-1">↗ war.gov</span>
            </a>
          ) : (
            <p class="font-mono text-xs text-[color:var(--color-text-dim)]">
              <span class="text-[color:var(--color-signal-amber)]">[NULL]</span>
            </p>
          )}

          {/* DoD provenance: original classification (when upstream alt-text
              embeds it) + VIRIN (DoDI 5040.02 identifier). Added 2026-05-14
              via tranche c9cc83fcaf43. ~13% of cards have an explicit
              classification level; the rest were declassified without a
              level recorded. VIRIN is now present on ~83% of cards. */}
          {(card.original_classification || card.image_virin) && (
            <dl class="mt-3 pt-3 border-t border-[color:var(--color-border)] font-mono text-[11px] space-y-1.5">
              {card.original_classification && (
                <div class="flex items-baseline gap-2">
                  <dt class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)]">
                    Class:
                  </dt>
                  <dd>
                    <span class="px-1.5 py-0.5 border border-[color:var(--color-signal-amber)]/60 text-[color:var(--color-signal-amber)] uppercase tracking-[0.15em] text-[10px]">
                      {card.original_classification}
                    </span>
                    <span class="ml-2 text-[10px] text-[color:var(--color-text-faint)] normal-case">declassified</span>
                  </dd>
                </div>
              )}
              {card.image_virin && (
                <div class="flex items-baseline gap-2">
                  <dt class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)]">
                    VIRIN:
                  </dt>
                  <dd class="text-[color:var(--color-text)]" title="Visual Information Record Identification Number (DoDI 5040.02)">
                    {card.image_virin}
                  </dd>
                </div>
              )}
            </dl>
          )}
        </section>

        {pairings.length > 0 && (
          <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4">
            <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-3">
              CROSS-REFERENCES
            </h2>
            <ul class="font-mono text-xs space-y-1.5">
              {pairings.map((p) => (
                <li class="text-[color:var(--color-text)]">
                  <span class="text-[color:var(--color-text-faint)] uppercase">{p.label}:</span>
                  <span class="ml-2 text-[color:var(--color-signal-cyan)]">{p.value}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {altTitles.length > 0 && (
          <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4">
            <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-3">
              ALSO CATALOGED UPSTREAM AS
            </h2>
            <p class="font-mono text-[10px] leading-relaxed text-[color:var(--color-text-dim)] mb-3">
              Upstream lists this same file under additional catalog entries. The byte-truth is one PDF; the cross-references are editorial framings DoW publishes for the same underlying document.
            </p>
            <ul class="font-mono text-xs space-y-2">
              {altTitles.map((alt) => (
                <li class="text-[color:var(--color-text)]">
                  <div class="text-[color:var(--color-text-bright)] leading-snug">{alt.title}</div>
                  {alt.dvids_video_id && (
                    <div class="text-[10px] text-[color:var(--color-text-faint)] mt-0.5">
                      DVIDS{" "}
                      <a
                        href={`https://www.dvidshub.net/video/${alt.dvids_video_id}`}
                        target="_blank"
                        rel="noreferrer"
                        class="text-[color:var(--color-signal-violet)] hover:text-[color:var(--color-text-bright)]"
                      >{alt.dvids_video_id} ↗</a>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4">
          <h2 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-3">
            OCR TEXT
          </h2>
          <p class="font-mono text-xs leading-relaxed text-[color:var(--color-text-dim)]">
            Per-page OCR transcript renders below. Use
            <code class="text-[color:var(--color-signal-cyan)]">#page-N</code>
            anchors to deep-link into a specific page.
          </p>
        </section>
      </aside>
    </div>

    {/* OCR transcript — full width, collapsible per page */}
    <section class="space-y-3 pt-2" id="ocr">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] flex items-center gap-2">
        <span class="text-[color:var(--color-signal-green)]">▸</span> OCR TRANSCRIPT
      </h2>
      <CardOcrIsland
        client:load
        cardId={card.card_id}
        base={base}
        assetType={card.asset_type}
        assetUrl={card.asset_url}
      />
    </section>

    {/* Provenance — novelty / "previously-disclosed" matches against the reference corpus */}
    <section class="space-y-3 pt-2" id="provenance">
      <CardProvenance client:load cardId={card.card_id} base={base} />
    </section>
  </article>

  {/* Bootstrap script: keeps the PDF iframe synced to whatever #page-N
       (or ?page=N) the URL carries on initial load and on hashchange.
       Reader-mode pagination from within the island syncs its own iframe
       writes; this script handles entry-point links (citations, pastes). */}
  <script>
    import "../../scripts/card-pdf-bootstrap.ts";
  </script>
</Base>
