---
import Base from "../layouts/Base.astro";
import GalleryIsland from "../components/GalleryIsland.tsx";
import { manifest } from "../data/manifest-loader";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Gallery renders IMG, VID, and PDF cards. PDF tiles use page-1
// WebP thumbnails from /data/thumbs/<card_id>.webp (built by
// scripts/build_pdf_thumbs.py); when no thumbnail exists yet the
// PDF tile falls back to a generic document placeholder.
const galleryCards = manifest.cards.filter(
  (c) =>
    c.asset_type === "IMG" ||
    c.asset_type === "VID" ||
    c.asset_type === "PDF",
);
---

<Base title="GALLERY — PURSUE://INDEX" active="gallery">
  <div class="space-y-6">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4 max-w-4xl">
      <div class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>ls -la data/&#123;images,videos&#125;/</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        GALLERY
      </h1>
      <p class="text-sm text-[color:var(--color-text)] max-w-2xl">
        Visual browse across every asset type in the corpus &mdash;
        declassified photographs, DVIDS-hosted videos, and page-1
        previews of every PDF. Tap any tile to open its card page;
        we don't trap you in a modal. Filter by type with the row of
        buttons; tiles render in newest-first order within each filter.
      </p>
    </header>
    <GalleryIsland client:load cards={galleryCards} base={base} />
  </div>
</Base>
