---
import Base from "../layouts/Base.astro";
import GalleryIsland from "../components/GalleryIsland.tsx";
import { manifest } from "../data/manifest-loader";
import photoCardIds from "../data/photo-card-ids.json";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Photo-content-as-PDF allow-list. `asset_type=PDF` cards in this set
// (B001-B024, FBI Composite Sketch, CENTCOM declass-header still
// images) are visually photographs but wrapped in a PDF container by
// upstream. The gallery's IMAGES filter unions them with the existing
// `asset_type=IMG` cards so operator searches for photographs find
// them all. See scripts/build_photo_card_index.py for the predicate
// and the source-of-truth threshold survey.
const photoPdfIds = (photoCardIds as { card_ids: string[] }).card_ids;

// Gallery renders IMG, VID, and PDF cards. PDF tiles use page-1
// WebP thumbnails from /data/thumbs/<card_id>.webp (built by
// scripts/build_pdf_thumbs.py); when no thumbnail exists yet the
// PDF tile falls back to a generic document placeholder.
//
// Deduplicate by card_id: the manifest contains 158 rows
// but only ~146 unique card_ids — PR-series videos share the parent
// MISREP's content-addressed card_id (e.g., PR26+PR27 collide on
// d8e5687dc870892d for D23, PR31+PR32+PR33 on ea029a05470b8f4e for
// D32). Without this dedup the gallery would render the same tile
// 2-3× for colliding card_ids and produce duplicate React keys.
// First-row-wins matches the video-poster extractor's behavior.
const _seenCardIds = new Set<string>();
const galleryCards = manifest.cards.filter((c) => {
  // AUD added to the allow-list — GalleryIsland's VIDEOS
  // lane predicate unions VID and AUD, but a card has to pass this
  // page-level filter first to reach the island. Without this, AUD
  // cards are invisible on /gallery despite all the AUD wiring in
  // GalleryIsland.tsx.
  if (
    c.asset_type !== "IMG" &&
    c.asset_type !== "VID" &&
    c.asset_type !== "PDF" &&
    c.asset_type !== "AUD"
  ) {
    return false;
  }
  if (_seenCardIds.has(c.card_id)) return false;
  _seenCardIds.add(c.card_id);
  return true;
});
---

<Base title="GALLERY — PURSUE://INDEX" active="gallery">
  <div class="space-y-6">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4 max-w-4xl">
      <div aria-hidden="true" class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>ls -la data/&#123;images,videos&#125;/</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        GALLERY
      </h1>
      <p class="text-sm text-[color:var(--color-text)] max-w-2xl">
        Visual browse across every asset type in the corpus &mdash;
        declassified photographs, videos served from our R2 archive
        (DVIDS is the cited provenance source), and page-1
        previews of every PDF. Tap any tile to open its card page;
        we don't trap you in a modal. Filter by type with the row of
        buttons; tiles render in newest-first order within each filter.
      </p>
    </header>
    <GalleryIsland client:load cards={galleryCards} base={base} photoPdfIds={photoPdfIds} />
  </div>
</Base>
