---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { manifest } from "../../data/manifest-loader";

export async function getStaticPaths() {
  const all = await getCollection("finds", ({ data }) => !data.draft);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageTitle = `${entry.data.title} — FINDS — PURSUE://INDEX`;
// Per-entry OG image rendered by scripts/build_finds_og_images.py and
// committed at web/public/og/finds/<slug>.png. New entries that haven't
// been built yet will 404 the image and scrapers will fall back to
// site-default behavior — run the script before deploying a new entry.
const perEntryOgImage = `${base}/og/finds/${entry.id}.png`;

// Resolve each card_id in the entry's frontmatter against the manifest so
// the "sources" rail can show agency/title alongside the id. Unknown ids
// (curator typo) render as amber warnings, mirroring the <Cite> guard.
const sourceCards = entry.data.cards.map((id) => {
  const card = manifest.cards.find((c) => c.card_id === id);
  return {
    id,
    title: card?.title ?? null,
    agency: card?.agency ?? null,
    known: card !== undefined,
  };
});
---

<Base
  title={pageTitle}
  description={entry.data.summary}
  active="finds"
  ogType="article"
  ogImage={perEntryOgImage}
  ogImageAlt={`${entry.data.title} — declassified-document OG card for PURSUE://INDEX FINDS entry`}
>
  <article class="space-y-6 max-w-3xl">
    <nav class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)] flex items-center gap-2">
      <a href={`${base}/finds`} class="hover:text-[color:var(--color-signal-green)]">/FINDS</a>
      <span>/</span>
      <span class="text-[color:var(--color-signal-cyan)]">{entry.id}</span>
    </nav>

    <header class="space-y-3 border-b border-[color:var(--color-border)] pb-5">
      <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)] flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="text-[color:var(--color-signal-cyan)]">
          {entry.data.published.toISOString().slice(0, 10)}
        </span>
        {entry.data.tags.length > 0 && <span>·</span>}
        {entry.data.tags.map((tag) => (
          <span class="px-1.5 py-0.5 border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] text-[color:var(--color-text-dim)]">
            {tag}
          </span>
        ))}
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)] leading-snug">
        {entry.data.title}
      </h1>
      {entry.data.subtitle && (
        <p class="text-base text-[color:var(--color-text-dim)]">{entry.data.subtitle}</p>
      )}
    </header>

    {sourceCards.length > 0 && (
      <aside class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-4">
        <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)] mb-2">
          Sources · {sourceCards.length} card{sourceCards.length === 1 ? "" : "s"}
        </h3>
        <ul class="flex flex-wrap gap-2">
          {sourceCards.map((c) => (
            <li>
              {c.known ? (
                <a
                  href={`${base}/card/${c.id}`}
                  class="pi-cite"
                  title={`${c.agency ?? ""} · ${c.title ?? ""}`.trim()}
                  data-card={c.id}
                >
                  {c.agency && <span class="opacity-70">{c.agency}</span>}
                  {c.agency && <span class="opacity-50 px-1">·</span>}
                  <span>{c.id.slice(0, 8)}</span>
                </a>
              ) : (
                <span
                  class="pi-cite pi-cite-unknown"
                  title="Unknown card_id; manifest does not contain this id."
                  data-card={c.id}
                >
                  {c.id.slice(0, 8)}? UNKNOWN CARD
                </span>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="pi-prose max-w-none">
      <Content />
    </div>
  </article>
</Base>
