---
import Base from "../layouts/Base.astro";
import CardExplorer from "../components/CardExplorer.tsx";
import HomepageSearch from "../components/HomepageSearch.tsx";
import { cards as manifestCards, summary } from "../data/manifest-loader";
import { RELEASE, formatPageCount } from "../lib/release";
import { SITE_ORIGIN, itemListJsonLd } from "../lib/seo";

const s = summary();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fetchedDate = new Date(s.fetchedAt).toISOString().slice(0, 10);

// Sprint 4b Codex-P1 fix: the CardExplorer card grid hydrates from a
// runtime fetch of /data/cards-summary.json — crawlers without JS would
// see an empty grid. Inject a schema.org ItemList in <head> at SSR
// time so the canonical card enumeration is in the static HTML
// (~16 KB JSON; ~5 KB gzipped). Crawlers parse this as the authoritative
// list of cards; users still get the runtime-fetched interactive grid.
// See `web/src/lib/seo.ts::itemListJsonLd`.
const cardItemList = itemListJsonLd(
  manifestCards.map((c) => ({
    id: c.card_id,
    name: c.title,
    url: `${SITE_ORIGIN}${base}/card/${c.card_id}`,
  })),
);

// Hero example queries — each verified to return real corpus hits via
// `jq` against web/public/data/pages.json. Page-level AND counts captured
// at build time of this branch:
//   green fireballs    — 15 pages
//   Roswell            — 20 pages
//   Project Blue Book  —  9 pages
//   flying disc        — 446 pages
const heroExamples = [
  "green fireballs",
  "Roswell",
  "Project Blue Book",
  "flying disc",
] as const;

// PDF count for the hero strip — distinct from `s.total` (which spans
// PDF/IMG/VID), and explicitly the cards that contribute OCR'd text.
const pdfCount = s.byType.PDF ?? 0;
const ocrPageCountLabel = formatPageCount(RELEASE.ocrPageCount);
---

<Base
  title="PURSUE://INDEX — Declassified DOW UAP / UFO Document Archive"
  description={`Search ${ocrPageCountLabel} OCR'd pages of the declassified U.S. Department of War PURSUE UAP / UFO release — FBI memos, NASA records, mission reports & AARO findings.`}
  active="index"
  jsonLd={cardItemList}
>
  <div class="space-y-10">
    {/* ===== Hero — search-first primary affordance =====
        The corpus index lived behind a /search nav entry for the early
        preview, which led to repeated "I didn't know there was search"
        feedback. This fold makes search the immediately obvious thing
        you can do; the card grid still renders below for direct browsing. */}
    <section class="relative pi-bracket border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 px-4 py-8 sm:py-10 lg:py-14 scanlines-soft">
      {/* Terminal preamble — kept tight so the input dominates the fold.
          aria-hidden because the prompt is a decorative aesthetic flourish;
          the meaningful content (h1 + description) lives directly below. */}
      <div aria-hidden="true" class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.15em] sm:tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2 break-all">
        <span class="text-[color:var(--color-text-faint)] flex-shrink-0">$</span>
        <span class="break-all">grep -ri . /var/dow/pursue/ocr/</span>
      </div>

      <h1 class="mt-3 font-mono text-xl sm:text-2xl lg:text-3xl font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        DEPARTMENT OF WAR / PURSUE
        <span class="block text-[color:var(--color-text-dim)] text-sm sm:text-base font-normal mt-1 leading-snug">
          Presidential Unsealing &amp; Reporting System for UAP Encounters
        </span>
      </h1>

      {/* Stat strip — numbers are load-bearing for trust + framing. */}
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.15em] text-[color:var(--color-text-dim)] flex flex-wrap gap-x-3 gap-y-1">
        <span>
          <span class="text-[color:var(--color-signal-green)]">{ocrPageCountLabel}</span> PAGES
        </span>
        <span class="text-[color:var(--color-text-faint)]">·</span>
        <span>
          <span class="text-[color:var(--color-text-bright)]">{pdfCount}</span> PDF CARDS
        </span>
        <span class="text-[color:var(--color-text-faint)]">·</span>
        <span class="lowercase tracking-normal text-[color:var(--color-text-dim)]">
          OCR'd by {RELEASE.ocrEngineLabel}
        </span>
        <span class="text-[color:var(--color-text-faint)]">·</span>
        <span>
          SNAPSHOT <code class="text-[color:var(--color-signal-cyan)]">{fetchedDate}</code>
        </span>
      </p>

      {/* The actual search — centred and wide-but-not-edge-to-edge so the
          eye is drawn to the input on first paint. mx-auto + max-w caps the
          width on desktop while letting it go full-bleed on mobile. */}
      <div class="mt-6 sm:mt-8 mx-auto w-full sm:max-w-2xl lg:max-w-3xl">
        {/* Sprint 2 perf-pass: the homepage hero used to mount the full
            SearchIsland with `client:load`, which fetched the 7.1 MB
            pages.json + built a MiniSearch index of ~4,127 docs on
            EVERY homepage visit — the LCP-path asset in APAC, the
            dominant TBT contributor. Replaced with a shortcut input
            that redirects to /search?q=… and lets that route pay
            hydration honestly. `client:idle` because the input itself
            doesn't need to be interactive in the first paint
            millisecond — the browser's native focus + onSubmit handle
            an enter-press just fine pre-hydration. See
            docs/perf-baseline.md. */}
        <HomepageSearch client:idle base={base} examples={heroExamples} />
        {/* Secondary affordance: a low-key link into the 2D semantic
            browser. Subtle on purpose — search remains the headline. */}
        <p class="mt-4 text-[11px] font-mono uppercase tracking-[0.18em] text-[color:var(--color-text-faint)]">
          or
          <a
            href={`${base}/atlas`}
            class="ml-1 text-[color:var(--color-signal-cyan)] hover:text-[color:var(--color-text-bright)] transition-colors"
          >explore by topic →</a>
        </p>
      </div>
    </section>

    {/* ===== Brief framing — one sentence, tighter than /about =====
        Second paragraph names the augmented-retrieval integration. The
        ~27% figure matches /methodology's ▸ Augmented retrieval section
        and embed_index.json's `augmented_by` accounting (1,132 / 4,127
        embedded pages). Keep that single source of truth — don't drift. */}
    <section class="max-w-3xl space-y-3">
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <span class="font-mono text-[color:var(--color-signal-cyan)]">pursueindex</span>
        is a citable, hash-pinned archive of the U.S. Department of War's
        PURSUE UAP document releases. Every page is OCR'd, every claim links
        back to the original <code class="text-[color:var(--color-signal-cyan)]">war.gov</code>
        artifact, and full-text search runs entirely in your browser — no server, no tracking.
        <a
          href={`${base}/about`}
          class="ml-1 text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]"
        >More →</a>
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text-dim)]">
        <span class="font-mono text-[color:var(--color-signal-green)]">Augmented for what OCR can't read.</span>
        For ~27% of pages, we integrate vision-language descriptions of
        photographs, sketches, and marginalia from a parallel research
        project (<a
          href="https://github.com/AlexZhangji/ufo-pursue-open-atlas"
          target="_blank"
          rel="noreferrer"
          class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]"
        >AlexZhangji/ufo-pursue-open-atlas</a>) — provenance-labeled per chunk, never blended silently.
        <a
          href={`${base}/methodology#augmented-retrieval`}
          class="ml-1 text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]"
        >How →</a>
      </p>
    </section>

    {/* ===== Card grid — remains for direct browsing & bookmarked links ===== */}
    <section class="space-y-4">
      <header class="border-b border-[color:var(--color-border)] pb-2">
        <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
          ▸ All cards
          <span class="ml-3 text-[color:var(--color-text-faint)] font-normal lowercase tracking-[0.15em]">
            ({s.total} records · {Object.keys(s.byAgency).length} agencies · {s.redacted} redacted)
          </span>
        </h2>
      </header>
      {/* Sprint 2 perf-pass: was `client:load` — the explorer hydrated
          eagerly and parsed the 158-card props blob + fetched
          novelty.json on every visit. The card grid lives BELOW the
          fold on mobile (search hero takes the viewport), so
          `client:visible` defers hydration until the user scrolls
          there. CLS-safe because the server-rendered output already
          has the final dimensions: filter chrome is full-width and
          the grid is `grid-cols-1 sm:grid-cols-2 lg:grid-cols-3`
          with intrinsic li sizing.

          Sprint 4b Theme F: dropped the `cards` prop. CardExplorer
          fetches /data/cards-summary.json on hydration (prebuild
          generates the file from manifest.json). This removes a
          ~440 KB HTML-encoded JSON blob from dist/index.html. The
          252 KB JSON file is served once, CF-edge-cached under the
          existing /data/*.json rule, and gzips to ~50 KB on the
          wire. Lighthouse "Avoid an excessive DOM size" Best
          Practices flag — that's what this fixes. */}
      <CardExplorer client:visible base={base} />
    </section>
  </div>
</Base>
