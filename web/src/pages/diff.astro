---
import Base from "../layouts/Base.astro";
import DiffIsland from "../components/DiffIsland.tsx";
import { manifest } from "../data/manifest-loader";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="DIFF — PURSUE://INDEX" active="diff">
  <div class="space-y-6 max-w-4xl">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <div aria-hidden="true" class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>diff snapshots/prev.json data/latest.json</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        TRANCHE DIFF
      </h1>
      <p class="text-sm text-[color:var(--color-text)] max-w-2xl">
        Tracks what's new or removed between successive CSV snapshots from
        <code class="text-[color:var(--color-signal-cyan)]">war.gov</code>.
        The current manifest is always compared against the most recently
        committed snapshot under
        <code class="text-[color:var(--color-signal-cyan)]">/data/snapshots/</code>.
      </p>
    </header>
    <DiffIsland client:load current={manifest} base={base} />
  </div>
</Base>
