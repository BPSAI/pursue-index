---
import Base from "../layouts/Base.astro";
import { summary, manifest } from "../data/manifest-loader";
import { articleJsonLd, speakableJsonLd, breadcrumbJsonLd } from "../lib/seo";

const s = summary();

const aboutJsonLd = [
  articleJsonLd({
    id: "about",
    data: {
      title: "About — pursue-index",
      summary: "About pursue-index — a citable, hash-pinned archive of the U.S. Department of War PURSUE UAP document releases.",
      cards: [],
      published: new Date("2026-05-08T00:00:00Z"),
      updated: new Date(manifest.fetched_at),
      tags: ["about"],
    },
  }),
  // Sprint 4b Theme E4: expanded from one selector to three so a
  // voice-assistant read covers the project framing (lede) + the
  // image-observations differentiator + the motivation. Each
  // selector targets a stable anchored paragraph so future page
  // restructuring breaks the link visibly rather than silently.
  speakableJsonLd(["#about-lede", "#about-augmented", "#about-why"]),
  breadcrumbJsonLd([
    { name: "Index", url: "/" },
    { name: "About", url: "/about" },
  ]),
];
---

<Base
  title="ABOUT — PURSUE://INDEX — Declassified DOW UAP / UFO Archive"
  description="About pursueindex — a citable, hash-pinned archive of the declassified U.S. Department of War PURSUE UAP / UFO document releases. Reproducible primary source."
  active="about"
  jsonLd={aboutJsonLd}
>
  <div class="space-y-6 max-w-3xl">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <div aria-hidden="true" class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>cat /etc/pursue/about.txt</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        ABOUT
      </h1>
    </header>

    <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 pi-bracket relative scanlines-soft space-y-3">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ What pursueindex is
      </h2>
      <p id="about-lede" class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <span class="font-mono text-[color:var(--color-signal-cyan)]">pursueindex</span>
        is a searchable, citable archive of the U.S. Department of War's
        <em>Presidential Unsealing &amp; Reporting System for UAP Encounters</em>
        (PURSUE) document releases. Every record in the
        <span class="text-[color:var(--color-text-bright)] font-medium">{s.total}</span>-card
        corpus is hash-pinned to the source CSV; every asset URL resolves
        directly to the original
        <code class="text-[color:var(--color-signal-cyan)]">war.gov</code>
        artifact. The site organizes the corpus by agency, asset type,
        release date, and incident date, and runs full-text search across
        every OCR'd page entirely in the browser — no server, no tracking.
      </p>
    </section>

    {/* Image observations callout — condensed version of the
        /methodology#image-observations section. Surfaced on /about
        because it's a project differentiator that a casual visitor
        landing on /about should see without having to click into
        methodology. Deliberately unquantified — it covers only the small
        residual of genuinely image-only pages. */}
    <section class="border border-[color:var(--color-signal-green)]/40 bg-[color:var(--color-signal-green)]/5 p-5 space-y-3">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Image observations
      </h2>
      <p id="about-augmented" class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Some pages carry no machine-readable text at all — a photograph, a
        sketch, a blank archival folder cover. For those genuinely image-only
        pages, our own operator-reviewed vision pass (Claude Opus) supplies a
        faithful, literal description as the page's searchable text. It is
        used only where base OCR is empty, and every such chunk is
        provenance-labeled so a reader can always tell a passage came from our
        vision pass rather than the document's own text.
        <a href="/methodology#image-observations" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">Methodology →</a>
      </p>
    </section>

    <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Why we built it
      </h2>
      <p id="about-why" class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The DOW publishes a single CSV. The official portal is a paginated
        DataTables widget — fine for browsing one record at a time, useless
        for searching the actual contents of the documents. This is the
        first public effort to programmatically index and search the PURSUE
        corpus end-to-end: ingest the CSV, fetch the PDFs, OCR every page,
        and ship the resulting index as a static, in-browser search experience.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The source documents are public domain; we add only the indexing
        layer — manifest, OCR transcripts, diff history, search index. The
        pipeline is fully reproducible from a clean clone and a copy of the
        upstream CSV. <a href="/methodology" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">See methodology</a>.
      </p>
    </section>

    <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Who built it
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <span class="font-mono text-[color:var(--color-signal-cyan)]">BPS AI Software</span>
        — an in-house engineering effort. The v1 byline is the org; named
        attribution will follow once the chat interface and review pipeline
        ship. The project is open-source; the
        <a href="https://github.com/BPSAI/pursue-index" target="_blank" rel="noreferrer" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">repository</a>
        carries the manifest, ingest code, and this site under one tree.
      </p>
    </section>

    <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Editorial standards
      </h2>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-2 list-none pl-0">
        <li>
          <span class="text-[color:var(--color-signal-amber)] font-mono text-xs uppercase tracking-[0.18em]">Citations · </span>
          Every factual claim links to a specific page of a specific card.
          No paraphrase without a source link.
        </li>
        <li>
          <span class="text-[color:var(--color-signal-amber)] font-mono text-xs uppercase tracking-[0.18em]">Restraint · </span>
          The site does not speculate beyond what the documents literally say.
          Document <em>reports</em> are distinguished from document
          <em>conclusions</em>.
        </li>
        <li>
          <span class="text-[color:var(--color-signal-amber)] font-mono text-xs uppercase tracking-[0.18em]">Abstention · </span>
          "The corpus does not contain that information" is a first-class
          answer. When the chat ships, it will say so explicitly rather than
          fabricate.
        </li>
        <li>
          <span class="text-[color:var(--color-signal-amber)] font-mono text-xs uppercase tracking-[0.18em]">Redactions · </span>
          Preserved as
          <code class="text-[color:var(--color-signal-red)]">[REDACTED]</code>.
          We do not guess at what was withheld.
        </li>
      </ul>
    </section>

    <section
      id="status"
      class="border border-[color:var(--color-signal-amber)]/40 bg-[color:var(--color-signal-amber)]/5 p-5 space-y-3 scroll-mt-20"
    >
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-amber)]">
        ▸ Status · research preview
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The site is currently in
        <span class="font-mono text-[color:var(--color-signal-amber)] uppercase tracking-[0.15em]">research preview</span>.
        Live now:{" "}
        <a href="/" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">corpus index</a>
        with full-text search, OCR transcripts (the llm-dots engine — Claude
        Sonnet 4.6 vision with a local dots.mocr content-filter backstop; audio
        cards via AssemblyAI; legacy Surya/Tesseract on some retired pages),{" "}
        <a href="/atlas" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">/atlas</a>
        (semantic browser),{" "}
        <a href="/gallery" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">/gallery</a>
        (image + video tile browse),{" "}
        <a href="/finds" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">curated finds</a>
        (hand-authored reading guides), tranche diff,{" "}
        <a href="/removed" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">/removed</a>
        (preserved-here index for upstream-pulled cards), the
        <a href="/chat" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">chat interface</a>
        (RAG with mandatory citations; BYOK supported), and the published
        quality benchmark on{" "}
        <a href="/methodology#benchmark" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">/methodology</a>.
        Still in flight post-launch:
      </p>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-1 pl-5 list-disc marker:text-[color:var(--color-text-faint)]">
        <li>
          <span class="text-[color:var(--color-text-bright)]">Curated finds expansion</span> —
          a small set of entries is live; more reading guides being authored.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">Novelty detection</span> —
          per-page comparison against prior FOIA archives (Black Vault, etc.)
          to surface what's genuinely new in this release. Target: shortly
          after launch, not before.
        </li>
      </ul>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)] pt-2">
        STATUS · <span class="text-[color:var(--color-signal-amber)]">RESEARCH PREVIEW</span>
        <span class="mx-2">·</span>
        CSV · <span class="text-[color:var(--color-signal-cyan)]">{s.csvSha256.slice(0, 12)}</span>
        <span class="mx-2">·</span>
        N · <span class="text-[color:var(--color-text-bright)]">{s.total}</span>
      </p>
    </section>
  </div>
</Base>
