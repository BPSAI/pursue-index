---
/**
 * /altered/ — facts-only listing of cards whose upstream bytes changed.
 *
 * Restored from the v1.2.2 retirement (which removed both this
 * listing AND the misleading per-card OCR text diffs). The diffs
 * stay retired; this listing comes back as a *facts-only* surface:
 * one row per card in `byte-history.json`, with the operator's
 * descriptive category as commentary on the byte change rather than
 * as a gate that hides cards.
 *
 * Vocabulary (from the published v3 bundle):
 *   - re_processing          bytes changed, no visible content change
 *   - procedural_correction  non-destructive correction (rotation, declared typo fix, re-scan)
 *   - content_change         editorially-significant change
 *   - (unverified)           multi-sha card with no operator verdict yet
 *
 * Bytes-changed is a factual signal we report; what kind of change
 * occurred is operator-attached commentary on each card. Filterable,
 * never load-bearing on hiding.
 *
 * Source plan: pursue-opsec/findings/2026-05-27-altered-surface-un-retirement-and-verdict-vocabulary.md
 */
import Base from "../layouts/Base.astro";
import byteHistoryJson from "../data/byte-history.json";
import { manifest } from "../data/manifest-loader";
import {
  archiveHrefFromKey,
  categoryClass,
  categorySlug,
  formatBytes,
  sizeDeltaPct,
} from "../lib/byte-display";
import { loadVerdictBundle } from "../lib/verdict-bundle";

// Bundle schema-version gate now lives in the loader (PR #79: was
// previously inline + one-sided across consumers).
const bundle = loadVerdictBundle();

type ByteHistoryEntry = {
  byte_sha256: string;
  byte_size: number;
  fetched_at: string;
  archive_key: string;
  asset_filename: string | null;
  is_current: boolean;
};

type VerdictRecord = {
  card_id: string;
  category?: string;
  rationale?: string;
};

const byteHistory = byteHistoryJson as Record<string, ByteHistoryEntry[]>;
const verdicts = bundle.verdicts as Record<string, VerdictRecord>;
const generatedAt = bundle.generated_at;
const bundleSchemaVersion = bundle.bundle_schema_version;

const titleMap = new Map<string, string>(
  manifest.cards.map((c) => [c.card_id, c.title ?? ""]),
);

type AlteredRow = {
  cardId: string;
  title: string;
  category: string | null;
  rationale: string;
  firstSha: string;
  firstArchiveKey: string;
  firstSize: number;
  latestSha: string;
  latestArchiveKey: string;
  latestSize: number;
  latestFetchedAt: string;
  sizeDelta: string;
};

const RATIONALE_PREVIEW_CHARS = 80;

function buildRow(cardId: string, history: ByteHistoryEntry[]): AlteredRow {
  // History is newest-first per build_byte_history.mjs.
  const latest = history[0];
  const first = history[history.length - 1];
  const verdict = verdicts[cardId];
  const rationale = verdict?.rationale ?? "";
  return {
    cardId,
    title: titleMap.get(cardId) || "(unknown)",
    category: verdict?.category ?? null,
    rationale,
    firstSha: first.byte_sha256,
    firstArchiveKey: first.archive_key,
    firstSize: first.byte_size,
    latestSha: latest.byte_sha256,
    latestArchiveKey: latest.archive_key,
    latestSize: latest.byte_size,
    latestFetchedAt: latest.fetched_at,
    sizeDelta: sizeDeltaPct(first.byte_size, latest.byte_size),
  };
}

const rows: AlteredRow[] = Object.entries(byteHistory)
  .map(([cardId, history]) => buildRow(cardId, history))
  .sort((a, b) => (a.latestFetchedAt < b.latestFetchedAt ? 1 : -1));

const totalCards = rows.length;

// PR #79: pill counts MUST derive from the same
// source as the table rows, not from bundle.stats. Otherwise the
// pill labels and the filterable row set can drift if
// byte-history.json and the bundle disagree about which cards
// exist (today they agree at 71 each; tomorrow they might not).
// Single source of truth = the rendered rows.
//
// Note on "unverified" (PR #79): the pill's
// `unverified` counts byte-history rows the consumer renders
// without an operator category — bundle.stats.unverified counts
// curate-side queue rows without an emitted verdict. Today both
// = 0; if they ever desync (a byte-history card with no bundle
// verdict), the pill reflects the rendered listing's
// denominator; bundle.stats reflects curate's queue. The
// symmetric-drift test in build_byte_history.test.mjs allows
// unverdicted byte-history entries by design — pill takes
// precedence on /altered/ because it's what the operator-facing
// table shows.
function countByCategory(cat: string | null): number {
  if (cat === null) return rows.filter((r) => r.category === null).length;
  return rows.filter((r) => r.category === cat).length;
}
const pillCounts = {
  re_processing: countByCategory("re_processing"),
  procedural_correction: countByCategory("procedural_correction"),
  content_change: countByCategory("content_change"),
  unverified: countByCategory(null),
};

function rationalePreview(text: string): string {
  if (!text) return "";
  // Collapse whitespace before slicing — PR #79:
  // raw operator rationale can contain newlines that would inject a
  // line break into the inline <span> if sliced mid-line. Normalize
  // first so the preview is a single clean line.
  const normalized = text.replace(/\s+/g, " ").trim();
  if (normalized.length <= RATIONALE_PREVIEW_CHARS) return normalized;
  return normalized.slice(0, RATIONALE_PREVIEW_CHARS).trimEnd() + "…";
}

const title = `Altered — ${totalCards} cards with upstream byte changes`;
const description =
  `${totalCards} cards have had their upstream document bytes change since first capture. ` +
  "Bytes-changed is a factual signal; operator commentary attaches per-card as a descriptive category.";
---

<Base title={title} description={description} active="altered">
  <main class="font-mono text-sm leading-relaxed max-w-6xl mx-auto px-4 py-12 space-y-6">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <p class="text-[10px] uppercase tracking-[0.25em] text-[color:var(--color-text-faint)]">
        /altered/ · facts-only listing · bundle v{bundleSchemaVersion} · generated {generatedAt.slice(0, 10)}
      </p>
      <h1 class="text-2xl text-[color:var(--color-text-bright)]">
        <span class="text-[color:var(--color-signal-cyan)]">{totalCards}</span> cards with upstream byte changes
      </h1>
    </header>

    <section class="space-y-3 text-[color:var(--color-text-dim)]">
      <p>
        These <span class="text-[color:var(--color-text-bright)]">{totalCards} cards</span>{" "}
        had their upstream document bytes change since first capture. Bytes-changed
        is a factual signal we report; what kind of change occurred is{" "}
        <em>operator-attached commentary</em> on each card. Both versions of every
        changed file are preserved at content-addressed{" "}
        <code>/archive/&lt;sha&gt;.&lt;ext&gt;</code> URLs.
      </p>
      <p class="text-[10px] text-[color:var(--color-text-faint)]">
        See <a href="/methodology" class="text-[color:var(--color-signal-cyan)] underline">/methodology</a>{" "}
        for the bytes-changed-as-fact framing and the
        <code class="ml-1">re_processing</code> /
        <code>procedural_correction</code> /
        <code>content_change</code> vocabulary.
      </p>
    </section>

    <section class="space-y-3 border border-[color:var(--color-border)] p-4 bg-[color:var(--color-bg-deep)]/40">
      <h2 class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)]">
        Filter by operator category
      </h2>
      <div class="flex flex-wrap gap-2" data-altered-filter-pills>
        <button type="button" data-filter="all" class="altered-pill altered-pill-active px-3 py-1 text-xs border border-[color:var(--color-border)] hover:border-[color:var(--color-border-bright)]">
          all · {totalCards}
        </button>
        <button type="button" data-filter="re_processing" class="altered-pill px-3 py-1 text-xs border border-[color:var(--color-border)] hover:border-[color:var(--color-border-bright)]">
          re_processing · {pillCounts.re_processing}
        </button>
        <button type="button" data-filter="procedural_correction" class="altered-pill px-3 py-1 text-xs border border-[color:var(--color-border)] hover:border-[color:var(--color-border-bright)]">
          procedural_correction · {pillCounts.procedural_correction}
        </button>
        <button type="button" data-filter="content_change" class="altered-pill px-3 py-1 text-xs border border-[color:var(--color-border)] hover:border-[color:var(--color-border-bright)]">
          content_change · {pillCounts.content_change}
        </button>
        <button type="button" data-filter="unverified" class="altered-pill px-3 py-1 text-xs border border-[color:var(--color-border)] hover:border-[color:var(--color-border-bright)]">
          unverified · {pillCounts.unverified}
        </button>
      </div>
      <p class="text-[10px] text-[color:var(--color-text-faint)]">
        Filtering is a sort/visibility convenience — every row stays in the dataset, regardless of category.
      </p>
    </section>

    {/* The 7-column table needs more width than the max-w-6xl prose
        column. On xl+ break the table section out of that cap (up to
        88rem, but never past the viewport so it can't force a page-
        level horizontal scrollbar) and center it; below xl it stays
        within the parent and the title/rationale columns wrap so the
        overflow-scroll is a rare fallback, not the default. */}
    <section class="space-y-2 xl:w-[88rem] xl:max-w-[calc(100vw-2rem)] xl:relative xl:left-1/2 xl:-translate-x-1/2">
      <div class="overflow-x-auto border border-[color:var(--color-border)]">
        <table class="w-full text-xs">
          <thead class="bg-[color:var(--color-bg-deep)]/60">
            <tr class="text-left text-[10px] uppercase tracking-[0.15em] text-[color:var(--color-text-faint)]">
              <th class="px-3 py-2">card</th>
              <th class="px-3 py-2">title</th>
              <th class="px-3 py-2">first / latest sha</th>
              <th class="px-3 py-2">size delta</th>
              <th class="px-3 py-2">last fetched</th>
              <th class="px-3 py-2">category</th>
              <th class="px-3 py-2">rationale</th>
            </tr>
          </thead>
          <tbody data-altered-rows>
            {rows.map((row) => (
              <tr
                class="border-t border-[color:var(--color-border)] hover:bg-[color:var(--color-bg-deep)]/30"
                data-category={categorySlug(row.category)}
              >
                <td class="px-3 py-2 align-top">
                  <a href={`/altered/${row.cardId}/`} class="text-[color:var(--color-signal-cyan)] underline">
                    <code class="text-[10px]">{row.cardId.slice(0, 12)}…</code>
                  </a>
                </td>
                <td class="px-3 py-2 align-top text-[color:var(--color-text-bright)] max-w-[22rem] break-words">
                  <a href={`/card/${row.cardId}/`} class="hover:text-[color:var(--color-signal-cyan)]">
                    {row.title}
                  </a>
                </td>
                <td class="px-3 py-2 align-top">
                  <a href={archiveHrefFromKey(row.firstArchiveKey)} class="text-[color:var(--color-signal-cyan)] underline">
                    <code class="text-[10px]">{row.firstSha.slice(0, 8)}</code>
                  </a>
                  <span class="text-[color:var(--color-text-faint)]"> → </span>
                  <a href={archiveHrefFromKey(row.latestArchiveKey)} class="text-[color:var(--color-signal-cyan)] underline">
                    <code class="text-[10px]">{row.latestSha.slice(0, 8)}</code>
                  </a>
                </td>
                <td class="px-3 py-2 align-top text-[color:var(--color-text-dim)]">
                  <span class="text-[10px]">{formatBytes(row.firstSize)} → {formatBytes(row.latestSize)}</span>
                  <span class="block text-[10px] text-[color:var(--color-text-faint)]">{row.sizeDelta}</span>
                </td>
                <td class="px-3 py-2 align-top text-[10px] text-[color:var(--color-text-dim)]">
                  {row.latestFetchedAt.slice(0, 10)}
                </td>
                <td class="px-3 py-2 align-top">
                  {row.category ? (
                    <code class={`text-[10px] ${categoryClass(row.category)}`}>{row.category}</code>
                  ) : (
                    <em class="text-[10px] text-[color:var(--color-text-faint)]">(unverified)</em>
                  )}
                </td>
                <td class="px-3 py-2 align-top text-[10px] text-[color:var(--color-text-dim)] max-w-[26rem] break-words whitespace-normal">
                  {row.rationale ? rationalePreview(row.rationale) : <span class="text-[color:var(--color-text-faint)]">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[10px] text-[color:var(--color-text-faint)]">
        Default sort: newest fetched_at first. Click any sha to open the preserved bytes;
        click a card_id for the byte-history detail; click a title for the card's reader page.
      </p>
    </section>
  </main>

  <script>
    /* Client-side filter pills: toggle row visibility by data-category.
       Static-first: server-rendered table works without JS; pills add
       a sort/visibility convenience layer per source plan §"Listing
       page" ("filterable, not load-bearing on hiding"). */
    const pillContainer = document.querySelector("[data-altered-filter-pills]");
    const tbody = document.querySelector("[data-altered-rows]");
    if (pillContainer && tbody) {
      pillContainer.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;
        const button = target.closest<HTMLButtonElement>("button[data-filter]");
        if (!button) return;
        const filter = button.dataset.filter ?? "all";
        pillContainer.querySelectorAll(".altered-pill").forEach((el) => {
          el.classList.remove("altered-pill-active");
        });
        button.classList.add("altered-pill-active");
        tbody.querySelectorAll<HTMLTableRowElement>("tr[data-category]").forEach((row) => {
          row.style.display = filter === "all" || row.dataset.category === filter ? "" : "none";
        });
      });
    }
  </script>
</Base>
