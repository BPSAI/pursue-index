---
/**
 * /altered/ — operator-verification retirement notice.
 *
 * 79 cards in the corpus had their upstream bytes silently re-published
 * under the same identifier between 2026-05-08 and 2026-05-22. The
 * original surface treated those as "altered" and rendered per-card
 * text diffs. Operator review of every byte-comparable card found
 * 0 confirmed content edits — every byte-level difference reduced to
 * a re-encoding, re-scan, page rotation, or internal-PDF metadata
 * refresh on visually-identical content.
 *
 * What the original page rendered as "exact text changes" were OCR
 * variance artifacts on visually-identical scans, not real upstream
 * edits. This page replaces both the listing and the per-card diffs.
 * The bytes-changed receipts remain on each card page (amber banner
 * pointing to `/archive/<sha>.<ext>`); that's the substance of the
 * integrity claim and it stays.
 */
import Base from "../layouts/Base.astro";
import bundle from "../data/verdict-bundle.json";

const stats = (bundle as { stats: Record<string, number> }).stats;
const generatedAt = (bundle as { generated_at: string }).generated_at;
const bundleVersion = (bundle as { bundle_schema_version: number }).bundle_schema_version;

const title = "Operator review: 0 confirmed content changes";
const description =
  "Operator review of every card whose upstream bytes changed found 0 confirmed content edits across " +
  `${stats.total_in_queue} candidates. Bytes-changed receipts remain on each card page.`;
---

<Base title={title} description={description} active="altered">
  <main class="font-mono text-sm leading-relaxed max-w-3xl mx-auto px-4 py-12 space-y-6">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <p class="text-[10px] uppercase tracking-[0.25em] text-[color:var(--color-text-faint)]">
        /altered/ · retired 2026-05-25
      </p>
      <h1 class="text-2xl text-[color:var(--color-text-bright)]">
        Operator review: <span class="text-[color:var(--color-signal-cyan)]">0</span> confirmed content changes
      </h1>
    </header>

    <section class="space-y-4 text-[color:var(--color-text-dim)]">
      <p>
        <span class="text-[color:var(--color-text-bright)]">{stats.total_in_queue} cards</span>{" "}
        in the corpus had their upstream bytes re-published under the same identifier
        between 2026-05-08 and 2026-05-22. We treated those as potentially altered
        and built a per-card diff surface to surface the changes.
      </p>
      <p>
        Operator review of every byte-comparable card found <span class="text-[color:var(--color-text-bright)]">
        {stats.confirmed_content_change} confirmed content change{stats.confirmed_content_change === 1 ? "" : "s"}</span>.
        Every byte-level difference reduced to a re-encoding, a re-scan, a page
        rotation for readability, or an internal-PDF metadata refresh. The content
        itself was not edited in any case the operator reviewed.
      </p>
      <p>
        What the original surface rendered as "exact text changes" were
        OCR-variance artifacts on visually-identical content, not real upstream
        edits. The diff pages are coming down because they were misleading on
        interpretation, even though the bytes-changed receipt itself is accurate.
      </p>
    </section>

    <section class="space-y-3 border border-[color:var(--color-border)] p-4 bg-[color:var(--color-bg-deep)]/40">
      <h2 class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)]">
        Verdict bundle (v{bundleVersion}, generated {generatedAt.slice(0, 10)})
      </h2>
      <dl class="grid grid-cols-2 gap-x-6 gap-y-1 text-xs">
        <dt class="text-[color:var(--color-text-dim)]">Total reviewed</dt>
        <dd class="text-[color:var(--color-text-bright)]">{stats.verdicts_emitted}</dd>
        <dt class="text-[color:var(--color-text-dim)]">False positive (no content change)</dt>
        <dd class="text-[color:var(--color-signal-cyan)]">{stats.false_positive}</dd>
        <dt class="text-[color:var(--color-text-dim)]">Confirmed content change</dt>
        <dd class="text-[color:var(--color-text-bright)]">{stats.confirmed_content_change}</dd>
        <dt class="text-[color:var(--color-text-dim)]">Unsure</dt>
        <dd class="text-[color:var(--color-text-bright)]">{stats.unsure}</dd>
      </dl>
    </section>

    <section class="space-y-3 text-[color:var(--color-text-dim)]">
      <h2 class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)]">
        What stays
      </h2>
      <ul class="list-disc list-inside space-y-1">
        <li>
          Per-card byte-history banner on every affected card page — amber
          notice with links to preserved earlier versions.
        </li>
        <li>
          Content-addressed archive at <code>/archive/&lt;sha&gt;.&lt;ext&gt;</code>{" "}
          — the actual receipt; pre-edit bytes still reachable.
        </li>
        <li>
          Source classifications and OCR comparisons remain in the repository at{" "}
          <code>data/altered-classification.json</code> +{" "}
          <code>data/altered-ocr/</code> for anyone re-running the analysis.
        </li>
      </ul>
    </section>

    <section class="space-y-3 text-[color:var(--color-text-dim)]">
      <h2 class="text-[10px] uppercase tracking-[0.2em] text-[color:var(--color-text-faint)]">
        Restoration policy
      </h2>
      <p>
        If a future tranche surfaces a card with a <em>confirmed</em> content
        change — verified by operator review against pre/post bytes — the
        dynamic surface will be restored. Until then, this page is the
        honest read.
      </p>
    </section>
  </main>
</Base>
