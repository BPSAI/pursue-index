---
import Base from "../layouts/Base.astro";
import AtlasIsland from "../components/AtlasIsland.tsx";
import AtlasAccessibleBrowser from "../components/AtlasAccessibleBrowser.tsx";
import { cards, summary } from "../data/manifest-loader";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const s = summary();

// Build the canvas long-summary string from the same manifest-derived
// agency counts the visualization itself colors by. Renders inside
// `.sr-only` next to the canvas via aria-describedby so screen-reader
// users get the shape of the data without having to interpret pixels.
const agencyEntries = Object.entries(s.byAgency).sort((a, b) => b[1] - a[1]);
const agencySummaryParts = agencyEntries.map(([agency, n]) => `${n.toLocaleString()} ${agency}`);
const canvasLongSummary = `2D semantic projection of ${s.total.toLocaleString()} cards from the PURSUE corpus, colored by reporting agency: ${agencySummaryParts.join(", ")}. Pages on similar topics drift together. The accessible browse table below provides the same destinations in keyboard- and screen-reader-friendly form.`;
---

<Base
  title="ATLAS — PURSUE://INDEX"
  description="2D semantic browser of 4,127 OCR'd pages from the DOW PURSUE UAP releases. UMAP projection of voyage-3 embeddings; click any dot to open the source page."
  active="atlas"
>
  <div class="space-y-6">
    {/* ===== Hero ===== */}
    <section class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 px-4 py-6 sm:py-8 pi-bracket relative scanlines-soft">
      {/* Decorative shell prompt — see index.astro for rationale. */}
      <div aria-hidden="true" class="font-mono text-[10px] sm:text-[11px] uppercase tracking-[0.15em] sm:tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2 break-all">
        <span class="text-[color:var(--color-text-faint)] flex-shrink-0">$</span>
        <span class="break-all">umap --n_components 2 --random_state 42 ./voyage-3</span>
      </div>
      <h1 class="mt-3 font-mono text-xl sm:text-2xl lg:text-3xl font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        SEMANTIC BROWSER
        <span class="block text-[color:var(--color-text-dim)] text-sm sm:text-base font-normal mt-1 leading-snug">
          A 2D projection of the corpus — near = related
        </span>
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-text)] max-w-3xl">
        Each dot is one OCR'd page from the DOW PURSUE releases, placed
        by similarity in the 1024-dim
        <code class="text-[color:var(--color-signal-cyan)]">voyage-3</code>
        embedding space and projected to 2D with
        <a href={`${base}/methodology#atlas`} class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">UMAP</a>.
        Pages on similar topics drift together; agencies color-code into
        rough territories. Click any dot to open the source page in the
        reader. Type to filter — matches glow, the rest dim.
      </p>
    </section>

    {/* ===== The canvas itself =====
      ``client:visible`` defers hydration (and the parallel fetches for
      ``atlas-layout.json`` ~340 KB + ``pages.json`` ~7 MB) to when the
      user actually scrolls the canvas into view. The canvas typically
      sits below the hero on mobile, so paying for a ~7 MB hydration on
      initial paint was wasted bandwidth (nayru #8).

      A11y: the WebGL canvas is opaque to screen readers by design.
      We provide a programmatic summary via the .sr-only paragraph
      (referenced by aria-describedby on the island root) AND a
      separate accessible browse surface below — see
      `.paircoder/plans/accessibility-audit-and-remediation.md` for
      the rationale. Both link to the same /card/<id> destinations.
    */}
    <section aria-labelledby="atlas-canvas-heading">
      <h2 id="atlas-canvas-heading" class="sr-only">Semantic projection (visual canvas)</h2>
      <p id="atlas-canvas-summary" class="sr-only">{canvasLongSummary}</p>
      <AtlasIsland client:visible base={base} />
    </section>

    {/* ===== Accessible browse alternative — keyboard + screen reader =====
      The canvas above is a pixel-shader visualization; this table is the
      programmatic surface every visitor can use regardless of pointer or
      assistive-tech setup. Same data, same destinations. */}
    <AtlasAccessibleBrowser client:visible cards={cards} base={base} />

    {/* ===== Honest disclaimer ===== */}
    <section class="border border-[color:var(--color-signal-amber)]/30 bg-[color:var(--color-signal-amber)]/5 p-4 max-w-3xl">
      <p class="text-[11px] font-mono uppercase tracking-[0.18em] text-[color:var(--color-signal-amber)]">
        ▸ what you're looking at
      </p>
      <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-text)]">
        This is a low-dimensional approximation, not ground-truth topic
        groupings. UMAP preserves <em>local</em> neighborhoods well and
        global geometry only loosely; cluster boundaries here are not
        official topic labels. The layout would shift if rerun with a
        different seed — we pin
        <code class="text-[color:var(--color-signal-cyan)]">random_state=42</code>
        so it doesn't churn between commits, but that's a choice, not a
        truth.
      </p>
      <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-text)]">
        For projection details + tradeoffs, see
        <a href={`${base}/methodology#atlas`} class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">methodology / atlas</a>.
      </p>
    </section>
  </div>
</Base>
