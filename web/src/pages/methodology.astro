---
import Base from "../layouts/Base.astro";
import { manifest, summary } from "../data/manifest-loader";
import { articleJsonLd, speakableJsonLd, breadcrumbJsonLd } from "../lib/seo";
import { RELEASE, formatPageCount } from "../lib/release";
import {
  cleanupCoverage,
  describeRetiredEngines,
  describeSuryaMigration,
  describeSuryaMigrationBrief,
  readCleanupStats,
  readOcrCardIds,
  readSidecarModelBreakdown,
} from "../lib/methodology-data";
import cleanQcBundleJson from "../../public/data/clean-qc-bundle.json";

import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const s = summary();
const pageCountLabel = formatPageCount(RELEASE.ocrPageCount);

// Every corpus figure below is derived from the repo's own data at build
// time. The readers throw when an input is missing, so a build that cannot
// derive a number fails rather than publishing a remembered one. Astro
// resolves this module from two working directories, hence the candidates.
const here = dirname(fileURLToPath(import.meta.url));
const cleanupStats = readCleanupStats([
  resolve(process.cwd(), "public/data/pages-cleaned.json"),
  resolve(here, "../../public/data/pages-cleaned.json"),
]);
const sidecarModelBreakdown = readSidecarModelBreakdown([
  resolve(process.cwd(), "src/data/image-observations"),
  resolve(here, "../data/image-observations"),
]);
// Coverage is the intersection of two separately-read populations: the cards
// the cleanup pass looked at, and the cards carrying OCR text. Neither
// contains the other, so their totals are not comparable on their own.
const ocrCardIds = readOcrCardIds([
  resolve(process.cwd(), "public/data/pages.json"),
  resolve(here, "../../public/data/pages.json"),
]);
const coverage = cleanupCoverage(cleanupStats.cardIds, ocrCardIds);
const suryaPageCount = RELEASE.ocrEngineCounts["surya"] ?? 0;
const suryaSentence = describeSuryaMigration(suryaPageCount);
// The benchmark-history section states the same migration position; it reads
// from the same count in shorter words rather than repeating the paragraph.
const suryaSentenceBrief = describeSuryaMigrationBrief(suryaPageCount);
const retiredEnginesNote = describeRetiredEngines(RELEASE.ocrEngineCounts);

// Sprint 5d.1 + Option A escalation policy: every cleaned page
// gets cross-checked against its source image by Sonnet vision.
// Bundle lands here via `cp <PURSUE_DATA_ROOT>/curate/
// published/v<N>/clean-qc-bundle.json web/public/data/`.
// Restored 2026-06-06 after the 2026-06-05 full-corpus sweep
// produced real numbers (the prior section claimed 100% no-
// corrections from a pilot that never reached the judge tier
// and was removed 2026-06-03 commit 2438bc2 for honesty).
interface CleanQcBundle {
  bundle_schema_version: number;
  generated_at: string;
  runner_version: string;
  judge_model: string;
  cards: { card_id: string; page_count: number }[];
  stats: {
    total_pages: number;
    judge_ok: number;
    operator_review: number;
    rule_applied: number;
    no_corrections: number;
    judge_calls: number;
    est_total_cost_usd: number;
    baseline_cost_usd: number;
    savings_usd: number;
    savings_pct: number;
  };
}
const cleanQcBundle = cleanQcBundleJson as CleanQcBundle;
const cleanQcOperatorReviewPct = Math.round(
  (cleanQcBundle.stats.operator_review / cleanQcBundle.stats.total_pages) * 100,
);
const cleanQcJudgeOkPct = Math.round(
  (cleanQcBundle.stats.judge_ok / cleanQcBundle.stats.total_pages) * 100,
);
const cleanQcGeneratedDate = cleanQcBundle.generated_at.slice(0, 10);
const csvShort = manifest.csv_sha256.slice(0, 12);
const csvFull = manifest.csv_sha256;
const fetchedISO = manifest.fetched_at;
const fetchedDate = new Date(fetchedISO).toISOString().slice(0, 10);

// Article schema for the methodology page — AI Overviews prefers
// authored content. The "article" framing here is factual: this page
// documents the pipeline, with a named publisher and a dated review.
// Speakable highlights the canonical-citation paragraph for voice
// assistants. Selectors target the lead paragraph by its anchor id
// (`#methodology-lede`) so a future page restructuring doesn't break
// the speakable surface.
const methodologyJsonLd = [
  articleJsonLd({
    id: "methodology",
    data: {
      title: "Methodology — pursue-index",
      summary: "How the pursue-index corpus is fetched, hashed, OCR'd, and made reproducible.",
      cards: [],
      published: new Date("2026-05-08T00:00:00Z"),
      updated: new Date(fetchedISO),
      tags: ["methodology", "reproducibility", "provenance"],
    },
  }),
  // Sprint 4b Theme E4: expanded from one selector to three. The lede
  // (what this page covers) + the provenance section (the integrity
  // story) + the image-observations section (the project
  // differentiator). All three anchor IDs are stable section ids
  // that map directly to TOC entries on the page.
  speakableJsonLd([
    "#methodology-lede",
    "#provenance",
    "#image-observations",
  ]),
  breadcrumbJsonLd([
    { name: "Index", url: "/" },
    { name: "Methodology", url: "/methodology" },
  ]),
];
---

<Base
  title="METHODOLOGY — PURSUE://INDEX — DOW UAP / UFO OCR Pipeline"
  description="How the pursueindex corpus of declassified DOW UAP / UFO documents is fetched, hashed, OCR'd, and made reproducible — provenance and pipeline detail."
  active="methodology"
  jsonLd={methodologyJsonLd}
>
  <div class="space-y-6 max-w-3xl">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <div aria-hidden="true" class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>man pursue-index</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        METHODOLOGY
      </h1>
      <p id="methodology-lede" class="text-sm text-[color:var(--color-text-dim)] max-w-2xl">
        Every claim on this site traces back to a specific page of a specific
        document. This page documents how that pipeline works, end to end.
      </p>
    </header>

    {/* Research-preview disclosure — surfaces the calibration-in-progress
        framing up front so readers know which research-preview numbers to
        read as provisional. Linked from the site-wide topbar
        [RESEARCH PREVIEW] badge; deeper detail lives in the per-surface
        sections below (novelty, OCR, finds). */}
    <section id="research-preview" class="border border-[color:var(--color-signal-amber)]/50 bg-[color:var(--color-signal-amber)]/5 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-amber)]">
        ▸ Research preview ({RELEASE.version})
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        This site is a research preview. Raw transcripts, the manifest hash,
        and the content-addressed asset archive are stable across refinements;
        several derived surfaces are calibrated against limited inputs and
        will be refined as the project matures:
      </p>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-2 pl-5 list-disc marker:text-[color:var(--color-text-faint)]">
        <li>
          <span class="text-[color:var(--color-text-bright)]">Novelty detection.</span>
          Currently runs against a small synthetic placeholder reference
          corpus of 10 hand-crafted public-domain passages. A
          community-research-resource integration is in progress that
          replaces the placeholder with a substantial prior-disclosure
          archive — see the
          <a href="#novelty" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">provenance / novelty detection</a>
          section below for thresholds, status rules, and reference-corpus
          roadmap.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">Editorial /finds.</span>
          The reading guides reflect the current curatorial bar; coverage
          expands continuously and a guide's absence does not signal an
          absence of material on a topic.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">OCR confidence.</span>
          Reported per page; raw transcripts are canonical and every
          citation is anchored to a specific page
          (<code class="text-[color:var(--color-signal-cyan)]">card_id:page</code>),
          so a reader can always verify against the source image.
        </li>
      </ul>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The "research preview" label will be revised as each surface
        reaches maturity. Per-card disclosure-status chips carry an inline
        <code class="text-[color:var(--color-signal-cyan)]">(against preview corpus)</code>
        qualifier until the reference-corpus integration lands.
      </p>
    </section>

    {/* Source provenance */}
    <section id="provenance" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 pi-bracket relative scanlines-soft space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Source provenance
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The U.S. Department of War publishes the PURSUE corpus as a single
        CSV at
        <code class="text-[color:var(--color-signal-cyan)] break-all">war.gov/Portals/1/Interactive/2026/UFO/uap-data.csv</code>{" "}
        (this URL has rotated twice: from <code class="text-[color:var(--color-signal-cyan)]">uap-csv.csv</code>{" "}
        to <code class="text-[color:var(--color-signal-cyan)]">uap-release001.csv</code>{" "}
        on 2026-05-12, then consolidated to{" "}
        <code class="text-[color:var(--color-signal-cyan)]">uap-data.csv</code>{" "}
        on 2026-05-22 when Release 02 landed — upstream chose to keep
        every release in one mutating canonical file rather than split
        each tranche under its own filename). Every fetch snapshots that
        file, archives the raw bytes, and pins the SHA-256 in the
        manifest. If the upstream CSV changes — a new tranche, a
        corrected row, a withdrawn entry, or another filename rotation
        — the next snapshot produces a different hash and the diff page
        surfaces every per-card delta.
      </p>
      <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-3 font-mono text-[11px] space-y-1">
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span class="text-[color:var(--color-text-faint)] uppercase tracking-[0.15em]">Current snapshot</span>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span class="text-[color:var(--color-text-faint)]">FETCHED</span>
          <span class="text-[color:var(--color-text-bright)]">{fetchedDate}</span>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span class="text-[color:var(--color-text-faint)]">CSV_SHA256</span>
          <span class="text-[color:var(--color-signal-cyan)] break-all">{csvFull}</span>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1">
          <span class="text-[color:var(--color-text-faint)]">N_CARDS</span>
          <span class="text-[color:var(--color-text-bright)]">{s.total}</span>
        </div>
      </div>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Beyond hashing, we preserve.</strong>{" "}
        Every CSV byte stream we fetch lands content-addressed at
        <code class="text-[color:var(--color-signal-cyan)]">data/raw/csv/&lt;sha&gt;.csv</code>{" "}
        and is committed to git; the prior manifest is rotated into
        <code class="text-[color:var(--color-signal-cyan)]">data/manifests/snapshots/&lt;csv_sha&gt;.json</code>{" "}
        before being overwritten, with
        <code class="text-[color:var(--color-signal-cyan)]">snapshots/index.json</code>{" "}
        tracking every snapshot the diff page can compare against. Every
        referenced PDF / IMG asset is mirrored into Cloudflare R2 keyed
        by
        <code class="text-[color:var(--color-signal-cyan)]">archive/&lt;byte_sha256&gt;.&lt;ext&gt;</code>{" "}
        so a silent upstream overlay (same URL, different bytes) lands
        as a new archive row rather than a destructive overwrite. A
        daily byte-verify cron sweeps the manifest and opens a
        <code class="text-[color:var(--color-signal-cyan)]">silent-overlay-detected</code>{" "}
        issue on any divergence. The result: if a card is pulled or
        quietly rewritten upstream, you can still read the version we
        cited.
      </p>
    </section>

    {/* Altered surface — bytes-changed-as-fact framing (ALTR Phase 2) */}
    <section id="altered" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Altered surface (bytes-changed)
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Our integrity claim is that we preserve every version of every
        upstream document we capture. When bytes change for a card that
        remained in the upstream manifest, we record both versions and
        surface the change at{" "}
        <a href="/altered/" class="text-[color:var(--color-signal-cyan)] underline">/altered/</a>.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Whether a particular byte change was editorially distorting,
        procedurally non-destructive, or trivial re-processing is{" "}
        <em>operator-attached commentary</em> on each card — surfaced
        as a category and a freeform rationale, but never as a gate
        that hides cards. The category vocabulary:
      </p>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] list-disc list-inside space-y-1 pl-2">
        <li><code class="text-[color:var(--color-signal-cyan)]">re_processing</code> — bytes changed, no visible content change (re-encoding, re-render, format conversion, font subsetting, embedded metadata changes a reader can't see).</li>
        <li><code class="text-[color:var(--color-signal-amber)]">procedural_correction</code> — non-destructive change to improve usability or correctness (rotation for readability, declared typo fix, re-scan for image quality) — text or layout did change but not editorially distorting.</li>
        <li><code class="text-[color:var(--color-signal-red)]">content_change</code> — content actually changed in a way that matters editorially (new redactions, paragraphs added/removed, dates or named entities edited, substantive rewrites declared or otherwise).</li>
      </ul>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Filterable, not load-bearing on hiding. Both versions of every
        byte-changed file are preserved at content-addressed{" "}
        <code class="text-[color:var(--color-signal-cyan)]">/archive/&lt;sha&gt;.&lt;ext&gt;</code>{" "}
        URLs regardless of category.
      </p>
      <p class="text-xs leading-relaxed text-[color:var(--color-text-dim)]">
        Historical note: <code>/altered/</code> was retired in v1.2.2
        because the original per-card OCR text diffs were misleading
        — they captured OCR variance on visually-identical scans, not
        real upstream edits. The bytes-changed receipt itself is
        accurate; v1.3.0 restores the surface as a facts-only listing
        with operator-attached categories in place of the misleading
        diffs.
      </p>
    </section>

    {/* Scrape */}
    <section id="scrape" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ How we scrape
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        We fetch the public CSV directly from war.gov over HTTPS, hash the
        bytes, and pin the SHA256 in the manifest before the bytes touch
        anything else in the pipeline. Every poll-driven snapshot (every
        30 minutes) is archived under
        <code class="text-[color:var(--color-signal-cyan)]">data/raw/csv/&lt;sha&gt;.csv</code>{" "}
        (content-addressed) and committed to the repo, as a forensic
        trail of how the source has evolved over time. Local
        operator-driven runs of <code class="text-[color:var(--color-signal-cyan)]">pursue
        scrape run</code> archive separately to{" "}
        <code class="text-[color:var(--color-signal-cyan)]">data/csv-archive/</code>{" "}
        (timestamped); the integrity guarantee comes from the
        poll workflow's content-addressed archive committed alongside
        each manifest update.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        We deliberately do <em>not</em> use browser automation. The CSV is
        a static asset; once retrieved, the scrape stage is a one-shot
        operation. Avoiding a browser gives us a smaller, more reproducible
        pipeline — and removes the entire class of "the page changed its
        DOM" failures that plague scrapers built on rendered output.
      </p>
    </section>

    {/* OCR */}
    <section id="ocr" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ OCR pipeline
      </h2>
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-faint)]">
        ▸ Full benchmark details on GitHub:{" "}
        <a href="https://github.com/BPSAI/pursue-index/blob/main/docs/ocr-benchmark.md" target="_blank" rel="noreferrer" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">docs/ocr-benchmark.md</a>{" "}
        →
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The operated engine is <code class="text-[color:var(--color-signal-cyan)]">llm-dots</code>:
        Claude Sonnet 4.6 vision reads every page, with local dots.mocr as the
        content-filter backstop. Several engines sit behind a common interface;
        each page is rasterized once and routed to one of:
      </p>
      <div class="overflow-x-auto">
        <table class="w-full text-xs font-mono border-collapse">
          <thead>
            <tr class="border-b border-[color:var(--color-border-bright)] text-[color:var(--color-text-faint)] uppercase tracking-[0.15em] text-[10px]">
              <th class="text-left py-2 pr-4">Engine</th>
              <th class="text-left py-2 pr-4">Hardware</th>
              <th class="text-left py-2 pr-4">Strength</th>
              <th class="text-left py-2">Tradeoff</th>
            </tr>
          </thead>
          <tbody class="text-[color:var(--color-text)]">
            <tr class="border-b border-[color:var(--color-border)]">
              <td class="py-2 pr-4 text-[color:var(--color-signal-cyan)]">llm-dots (operated)</td>
              <td class="py-2 pr-4">API + local</td>
              <td class="py-2 pr-4">The operated engine: Claude Sonnet 4.6 vision reads every page, with local dots.mocr backstopping the rare page Sonnet's output filter blocks</td>
              <td class="py-2 text-[color:var(--color-text-dim)]">~$0.10 / 15pp at Sonnet rates; rate-limited; dots backstop needs an isolated venv</td>
            </tr>
            <tr class="border-b border-[color:var(--color-border)]">
              <td class="py-2 pr-4 text-[color:var(--color-signal-cyan)]">llm (Claude Sonnet 4.6)</td>
              <td class="py-2 pr-4">API</td>
              <td class="py-2 pr-4">The Sonnet vision pass on its own — reads the page image directly; the primary half of llm-dots</td>
              <td class="py-2 text-[color:var(--color-text-dim)]">Plain <code>--engine llm</code> 400s on content-filter pages, which is why the operated engine is llm-dots</td>
            </tr>
            <tr class="border-b border-[color:var(--color-border)]">
              <td class="py-2 pr-4 text-[color:var(--color-signal-cyan)]">dots (dots.mocr)</td>
              <td class="py-2 pr-4">local</td>
              <td class="py-2 pr-4">The content-filter (HTTP 400) backstop: re-OCRs exactly the pages Sonnet's output filter blocks, run in an isolated venv</td>
              <td class="py-2 text-[color:var(--color-text-dim)]">Local model; used only where the LLM path is filter-blocked</td>
            </tr>
            <tr>
              <td class="py-2 pr-4 text-[color:var(--color-signal-cyan)]">assemblyai</td>
              <td class="py-2 pr-4">API</td>
              <td class="py-2 pr-4">Transcribes AUD (audio) cards</td>
              <td class="py-2 text-[color:var(--color-text-dim)]">{retiredEnginesNote}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The operated pipeline runs{" "}
        <code class="text-[color:var(--color-signal-cyan)]">engine="llm-dots"</code>:
        Claude Sonnet 4.6 vision reads every page, and local dots.mocr re-OCRs
        the rare page Sonnet's output content filter blocks (an HTTP 400), so a
        mixed document keeps Sonnet everywhere except the filter-blocked page.
        The retired{" "}
        <code class="text-[color:var(--color-signal-cyan)]">engine="auto"</code>{" "}
        path (Surya-primary + LLM re-OCR of sub-confidence pages) is no longer
        operated.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Engine and per-page confidence are recorded in{" "}
        <code class="text-[color:var(--color-signal-cyan)]">pages.jsonl</code>{" "}
        and surfaced in the OCR transcript on each card page.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Current engine mix.</strong>{" "}
        Across the {pageCountLabel} indexed pages, the live breakdown is:
      </p>
      <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-3 font-mono text-[11px] space-y-1">
        {Object.entries(RELEASE.ocrEngineCounts)
          .sort((a, b) => b[1] - a[1])
          .map(([engine, count]) => {
            const pct = ((count / Object.values(RELEASE.ocrEngineCounts).reduce((s, n) => s + n, 0)) * 100).toFixed(1);
            return (
              <div class="flex flex-wrap gap-x-4 gap-y-1">
                <code class="text-[color:var(--color-signal-cyan)]">{engine}</code>
                <span class="text-[color:var(--color-text-dim)]">
                  {count.toLocaleString()} pages ({pct}%)
                </span>
              </div>
            );
          })}
      </div>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The split is now <strong class="text-[color:var(--color-text-bright)]">Sonnet-dominated</strong>:
        the bulk of pages carry the <code class="text-[color:var(--color-signal-cyan)]">llm</code>{" "}
        (Claude Sonnet 4.6) engine, from the Sonnet re-OCR pass plus every
        tranche from 5/22/26 onward (incl. Release-03, 6/12/26) OCR'd
        Sonnet-direct. The small{" "}
        <code class="text-[color:var(--color-signal-cyan)]">dots</code>{" "}
        count is the local dots.mocr content-filter backstop, used where
        Sonnet's output filter blocked the page (a CIA overhead-reconnaissance
        history). Engine and per-page confidence are recorded per page, so the
        credit follows the data rather than a hand-typed label.
      </p>

      <h3 id="vlm-bake-off" class="font-mono text-[11px] uppercase tracking-[0.18em] text-[color:var(--color-text-bright)] pt-3">
        ▸ Engine selection — VLM bake-off (2026-05-18)
      </h3>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        After Surya carried us through the v1.0 launch, an internal
        bake-off compared every credible 2026-current OCR engine on a
        25-page golden set drawn from the corpus — FBI carbon copies,
        DOW MISREP forms, NASA crew debriefings, with HARD-tier
        coverage of the worst pre-1960s typewriter material. Models
        tested: Anthropic Sonnet 4.6 / Opus 4.7, OpenAI gpt-5.4 /
        GPT-5.5 / o3 / o4-mini, Google Gemini 3.1 Pro, GLM-OCR (open
        weights, local), Reducto (closed-source commercial).
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Outcome:
        Sonnet 4.6 is the operated answer.</strong>{" "}
        Capped-mean CER 20.1% on the golden set, median CER 1.6%; ~$53
        to run the full corpus once. Why not the alternatives:
      </p>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-1 pl-5 list-disc marker:text-[color:var(--color-text-faint)]">
        <li><strong class="text-[color:var(--color-text-bright)]">Opus 4.7</strong> — materially worse on the same pages (cm-CER 20.2% vs 16.3% on the head-to-head 20); 7.2× more expensive (~$383); 1/25 content-filter trips.</li>
        <li><strong class="text-[color:var(--color-text-bright)]">gpt-5.4</strong> — viable cost-shrunk fallback (~$28 full corpus, +1.2 pp cm-CER, 2.5× faster wall-clock). Kept in reserve for vendor-availability failover.</li>
        <li><strong class="text-[color:var(--color-text-bright)]">o3 / GPT-5.5 / Sonnet+thinking</strong> — reasoning architectures regress on OCR (cross-vendor confirmation); HARD-tier worse than Sonnet baseline.</li>
        <li><strong class="text-[color:var(--color-text-bright)]">Gemini 3.1 Pro</strong> — 4.6 pp behind Sonnet overall; 6.9 pp behind on HARD tier.</li>
        <li><strong class="text-[color:var(--color-text-bright)]">Reducto</strong> — closed-source; Figure-block prose-description failure on 1/411 blocks; can't be operated by us.</li>
        <li><strong class="text-[color:var(--color-text-bright)]">GLM-OCR (open weights)</strong> — retained as a local cross-witness signal ($0 marginal, ~3-min full corpus on a single 5090). Uncorrelated failure modes — LaTeX leakage on plain text, won't honor [REDACTED] sentinel — make it useful as a sanity check, not as the operated primary.</li>
      </ul>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Other candidates surveyed, not benchmarked:</strong>{" "}
        Chandra OCR 2 (5B local-runnable, 85.9% OmniDocBench, modified
        OpenRAIL-M license with revenue conditions we wanted to think
        through before shipping it as the operated answer); dots.mocr;
        Infinity-Parser2-Pro (~34B MoE doesn't fit on a 5090 without
        aggressive quantization); LightOnOCR-2; PaddleOCR-VL.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Engine roadmap.</strong>{" "}
        Every tranche from 5/22/26 onward was OCR'd Sonnet-direct. {suryaSentence}{" "}
        The operated engine is
        <code class="text-[color:var(--color-signal-cyan)]">llm-dots</code>{" "}
        (Sonnet 4.6 primary + local dots.mocr as the content-filter backstop).
      </p>
    </section>

    {/* Image observations — our own vision pass over image-only pages.
        Positioned right after the OCR pipeline because it answers "what
        about pages that are pure imagery, where OCR reads nothing?" The
        load-bearing claim is provenance discipline: our vision description
        carries an inline [[IMAGE-OBSERVATIONS via pursue vision pass, …]]
        marker that travels into /api/retrieve snippet/page_text fields, and
        it is only ever used where base OCR is empty — we never blend OCR
        text and a model's description of the same page. (Superseded an
        earlier integration of Alex Zhang's open VLM dataset; see Related
        Work.) The bottom Related Work section points UP to this anchor. */}
    <section id="image-observations" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Image observations
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">image observations</strong>
        — some pages carry no machine-readable text at all: a photograph, a
        hand-drawn or composite sketch, a diagram, or a blank archival folder
        cover. OCR returns nothing for them. For these genuinely image-only
        pages we run our own vision pass — a faithful, literal,
        operator-reviewed description generated with
        <strong class="text-[color:var(--color-text-bright)]">Claude Opus</strong>
        — and use that description as the page's searchable text. It is used
        only where base OCR is empty; a page that already has readable OCR
        keeps its OCR verbatim. We never blend the two.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">What OCR can't read.</strong>
        Photographs of physical models and artifacts inside FBI case files.
        Hand-drawn and digitally composited sketches of reported objects.
        Cover sheets and blank dividers that scan as pure imagery. For each
        such page we render the source image from the archival PDF and
        describe exactly what is visible — transcribing any stamps or
        captions verbatim, and never asserting the nature or authenticity of
        a depicted object. Coverage is deliberately narrow: it is the small
        residual of pages that would otherwise be unsearchable, not a blanket
        pass over the corpus.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Operator-reviewed observations.</strong>
        A cluster of gun-camera and released-imagery cards (the late-2025
        helicopter–orb case) additionally carries structured, operator-verified
        image observations — reticle style, sensor-clock timestamps, tracked-object
        position — where the visual detail is load-bearing for the analysis.
        Those observations are recorded as machine-readable sidecars for
        provenance and are surfaced in the relevant finds entry.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">How provenance is labeled.</strong>
        Each image-observation sidecar records our pass explicitly — model,
        method, and the operator decision. Across {sidecarModelBreakdown.total} sidecars
        in the current corpus, the model split is:{" "}
        {Object.entries(sidecarModelBreakdown.modelCounts)
          .sort((a, b) => b[1] - a[1])
          .map(([model, count]) => `${model} (${count})`).join(", ")}.
        The description carries an inline
        <code class="font-mono text-xs">[[IMAGE-OBSERVATIONS via pursue vision pass, &lt;model&gt;]]</code>
        marker embedded directly in the
        <code class="text-[color:var(--color-signal-cyan)]">snippet</code> and
        <code class="text-[color:var(--color-signal-cyan)]">page_text</code>
        fields returned by
        <code class="font-mono text-xs">/api/retrieve</code>, so a reader can
        always tell a passage came from our vision pass rather than from the
        document's own text. Because the marker lives in the searchable text
        itself, the disambiguation is visible in raw transcripts too. See
        <a href="/cite" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">citation guidance</a>
        for how to credit an image-observation passage.
      </p>
    </section>

    {/* Reader cleanup overlay */}
    <section id="reader-cleanup" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Reader cleanup (opt-in)
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Cards offer three reading layers behind a toggle at the top-right
        of the OCR panel:
        <code class="text-[color:var(--color-signal-cyan)]">Raw</code>,
        <code class="text-[color:var(--color-signal-cyan)]">Reader</code>,
        and
        <code class="text-[color:var(--color-signal-cyan)]">Cleaned</code>.
        Raw is the canonical engine output. Reader is a presentation pass
        that reflows whitespace for prose typography without changing a
        single character of the text. Cleaned is an LLM pass that fixes
        obvious OCR errors — broken hyphenation across line breaks,
        column-detection scrambles, redaction-boundary glitches — without
        changing meaning.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The model is
        <code class="text-[color:var(--color-signal-cyan)]">claude-haiku-4-5-20251001</code>.
        It runs against the raw OCR text (no vision), is constrained by a
        sealed system prompt, and is told: do not reword, do not modernize
        spelling or grammar, do not expand abbreviations, do not change
        capitalization unless the OCR clearly misread it, do not touch
        anything inside a
        <code class="text-[color:var(--color-signal-red)]">[REDACTED]</code>
        marker. If the passage is too garbled to clean confidently, leave
        it unchanged.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Every cleaned page row carries a provenance tuple:
        <code class="text-[color:var(--color-signal-cyan)]">model_id</code>,
        <code class="text-[color:var(--color-signal-cyan)]">prompt_sha256</code>,
        <code class="text-[color:var(--color-signal-cyan)]">input_sha256</code>,
        <code class="text-[color:var(--color-signal-cyan)]">output_sha256</code>,
        <code class="text-[color:var(--color-signal-cyan)]">generated_at</code>.
        The prompt hash lets you reproduce the exact instruction the model
        was given; the input/output hashes let you confirm a passage you
        quote matches the bytes that were cleaned. The deployed mirror is
        <code class="text-[color:var(--color-signal-cyan)]">/data/pages-cleaned.json</code>{" "}
        and is only fetched when a visitor toggles to Cleaned, so users on
        Raw or Reader pay zero extra bytes.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">
          Raw remains canonical for citation.
        </strong>{" "}
        Cleaned is a presentation layer; the URL anchor format is unchanged
        (<code class="text-[color:var(--color-signal-cyan)]">/card/&lt;id&gt;#page-&lt;n&gt;</code>)
        and points at the canonical card record. When you quote a passage
        in the Cleaned view, the
        <a href="/cite" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">citation guide</a>{" "}
        explains the three-way provenance: source PDF, OCR pass, cleanup
        pass.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">
          Pages we couldn't clean.
        </strong>{" "}
        When the cleanup pass encounters source OCR that is blank or too
        garbled to clean confidently, it skips that page. The raw OCR in
        <code class="text-[color:var(--color-signal-cyan)]">pages.jsonl</code>
        is preserved unchanged; the cleaned mirror simply omits the cleaned
        text for those rows. The reader shows the raw OCR for all skipped pages
        and the reader view shows a notice when a raw-only page is viewed.
        Citation still anchors to Raw.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">
          Skip rate, cleanup-covered cards.
        </strong>{" "}
        The cleanup pass ran against {cleanupStats.cardsInCleanupPass}{" "}
        cards ({formatPageCount(cleanupStats.totalPagesInCleanupPass)} pages total),
        left {cleanupStats.cardsWithCleanedText} of them with at least one
        cleaned page, and produced cleaned text for
        <strong class="text-[color:var(--color-text-bright)]">{formatPageCount(cleanupStats.totalCleanedPages)}</strong>
        {" "}pages —
        <strong class="text-[color:var(--color-text-bright)]">{cleanupStats.skippedPages} pages</strong>{" "}
        skipped, a
        <strong class="text-[color:var(--color-text-bright)]">
          {((cleanupStats.skippedPages / cleanupStats.totalPagesInCleanupPass) * 100).toFixed(2)}%
        </strong>{" "}
        skip rate. Each skipped page is recorded with the reason it was
        skipped, and every one is preserved unchanged in the cleaned mirror:
      </p>
      <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-3 font-mono text-[11px] space-y-1">
        {cleanupStats.skipCauses.map(({ cause, count }) => (
          <div class="flex flex-wrap gap-x-4 gap-y-1">
            <code class="text-[color:var(--color-signal-cyan)]">{cause}</code>
            <span class="text-[color:var(--color-text-dim)]">
              {count.toLocaleString()} {count === 1 ? "page" : "pages"}
            </span>
          </div>
        ))}
      </div>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <code class="text-[color:var(--color-signal-cyan)]">empty_input</code>{" "}
        is a page whose source OCR was empty;{" "}
        <code class="text-[color:var(--color-signal-cyan)]">length_divergence</code>{" "}
        is a cleaned output too far from the raw text in length to accept;{" "}
        <code class="text-[color:var(--color-signal-cyan)]">content_filter</code>{" "}
        is a page the model's output filter refused. The cleanup pass
        currently covers {coverage.covered} of the {coverage.ocrCards}{" "}
        cards carrying OCR text; the rest are pending a subsequent pass.
        {coverage.outsideOcr > 0 && (
          <>
            {" "}The pass looked at {coverage.cleanupCards} cards in all: the
            other {coverage.outsideOcr} carry no OCR text at all, so they sit
            outside the population that figure is measured against.
          </>
        )}
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">
          The interpretive boundary.
        </strong>{" "}
        Cleaned is an OCR-error pass, not a transcription pass. The model
        is allowed to fix things like
        <code class="text-[color:var(--color-signal-cyan)]">1.48</code>{" "}
        →
        <code class="text-[color:var(--color-signal-cyan)]">1.4a</code>{" "}
        when an obvious single-character OCR misread is recoverable from
        context (a numbered list item where the surrounding text makes the
        intent unambiguous). It is{" "}
        <strong class="text-[color:var(--color-text-bright)]">not</strong>{" "}
        allowed to fill in what a redaction covers, expand abbreviations
        the original document didn't expand, or modernize archaic spellings.
        When a passage is genuinely garbled and the cleanup would require
        guessing rather than correcting, the model is instructed to leave
        it alone — the
        <code class="text-[color:var(--color-signal-cyan)]">length_divergence</code>{" "}
        skip path is the safety valve that catches the cases where it
        couldn't comply with that instruction. Quoting from Cleaned and
        reporting the underlying claim as if it were the original
        document's exact wording is the failure mode this section is here
        to warn against: when precision matters, quote Raw.
      </p>
    </section>

    {/* Sprint 5d.1 + Option A: every cleaned page cross-checked
        against the source image by Sonnet vision. Bundle generated
        by `curate publish clean-qc` and copied to web/public/data/
        manually after each sweep. */}
    <section id="clean-qc" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Cleaned-text quality review
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Cleaned text is generated by an LLM; an LLM can hallucinate
        normalizations, drop visible content, or silently propagate
        OCR errors. Spot-checking thousands of pages by hand is not a
        quality signal. The pipeline cross-checks every cleaned page
        against its source image: a Sonnet vision pass receives the
        rendered PDF page alongside the raw OCR, the cleaned text, and
        the rule-corrected text, and returns one of
        {" "}<code class="text-[color:var(--color-signal-cyan)]">ok</code>,
        {" "}<code class="text-[color:var(--color-signal-cyan)]">concern</code>,
        or {" "}<code class="text-[color:var(--color-signal-cyan)]">needs-fix</code>
        {" "}with a span-level evidence quote.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">Honest framing.</strong>{" "}
        The cross-check found that ~half of cleaned pages have
        something a careful reader should look at. It is not a
        sweeping condemnation of the cleanup pass — many flags are
        marginal calls about whether a 1960s document's idiosyncratic
        spelling should be preserved or normalized — but it is a
        signal that the cleaned text is a draft, not a final
        transcript. When precision matters, quote Raw or quote the
        source PDF directly.
      </p>
      <div class="border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-3 font-mono text-xs space-y-2">
        <div class="uppercase tracking-[0.2em] text-[10px] text-[color:var(--color-signal-green)]">
          ● Cross-check complete
        </div>
        <p class="text-[color:var(--color-text-dim)] leading-relaxed">
          Judge: <code class="text-[color:var(--color-text-bright)]">{cleanQcBundle.judge_model}</code> ·
          runner <code class="text-[color:var(--color-text-bright)]">v{cleanQcBundle.runner_version}</code> ·
          {" "}<strong class="text-[color:var(--color-text-bright)]">{cleanQcBundle.stats.total_pages.toLocaleString()}</strong> pages
          {" "}across <strong class="text-[color:var(--color-text-bright)]">{cleanQcBundle.cards.length}</strong> cards
          on <span class="text-[color:var(--color-text-bright)]">{cleanQcGeneratedDate}</span>.
        </p>
        <ul class="text-[color:var(--color-text-dim)] space-y-1">
          <li>
            <span class="text-[color:var(--color-signal-green)]">●</span>{" "}
            <strong class="text-[color:var(--color-text-bright)]">{cleanQcBundle.stats.judge_ok.toLocaleString()}</strong>
            {" "}<code>ok</code> ({cleanQcJudgeOkPct}%) — cleaned text faithful to the source image
          </li>
          <li>
            <span class="text-[color:var(--color-signal-amber)]">●</span>{" "}
            <strong class="text-[color:var(--color-text-bright)]">{cleanQcBundle.stats.operator_review.toLocaleString()}</strong>
            {" "}<code>operator-review</code> ({cleanQcOperatorReviewPct}%) — judge flagged a possible mismatch worth a human pass
          </li>
        </ul>
        <p class="text-[color:var(--color-text-faint)] leading-relaxed pt-1 border-t border-[color:var(--color-border)] mt-2">
          Cross-check cost ${cleanQcBundle.stats.est_total_cost_usd.toFixed(2)};
          the published bundle this section reads from is at{" "}
          <code>web/public/data/clean-qc-bundle.json</code>{" "}
          (schema v{cleanQcBundle.bundle_schema_version}). The per-page
          verdicts live in the source repo as well — see{" "}
          <a href="https://github.com/BPSAI/pursue-index/blob/main/web/public/data/clean-qc-bundle.json" target="_blank" rel="noreferrer" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">the bundle on GitHub</a>.
        </p>
      </div>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">What "operator-review" actually means.</strong>{" "}
        Sample patterns the judge surfaced: cleanup over-corrected the
        document's own period spelling
        ({" "}<code class="text-[color:var(--color-signal-cyan)]">FOURTY FIVE</code>
        {" "}→{" "}<code class="text-[color:var(--color-signal-cyan)]">FORTY FIVE</code>),
        changed a documented proper-noun nickname
        ({" "}<code class="text-[color:var(--color-signal-cyan)]">Geno</code>
        {" "}→{" "}<code class="text-[color:var(--color-signal-cyan)]">Gene</code>{" "}
        in an Apollo transcript), dropped handwritten annotations on a
        classification stamp, propagated OCR garbles that changed
        meaning (a mission designator
        {" "}<code class="text-[color:var(--color-signal-cyan)]">17</code>
        {" "}rendered as{" "}<code class="text-[color:var(--color-signal-cyan)]">LJ</code>).
        Many flags are recoverable from context; a few are
        substantive. The operator-review queue is what powers the
        per-page chips on the reader-mode card view (when present).
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        <strong class="text-[color:var(--color-text-bright)]">What we don't do.</strong>{" "}
        We do not silently rewrite the cleaned text based on the
        judge's verdict. The cleaned text shown to readers is the
        cleanup pass output, unchanged; the judge's flag becomes a
        visible chip and a sidecar JSONL row, both inspectable. The
        operator triages flags into accept-cleaned / restore-raw /
        manually-edit decisions on a per-page basis, with the source
        image in view. Any edit lands as an explicit revision, not a
        silent cleanup re-run.
      </p>
    </section>

    {/* Idempotency */}
    <section id="idempotency" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Idempotency
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Every stage — scrape, download, OCR, index — is idempotent against
        a content-hashed manifest. The card identifier is derived from the
        upstream asset URL, with title as a fallback for the rare metadata-only
        row:
      </p>
      <pre class="bg-[color:var(--color-bg-elevated)] border border-[color:var(--color-border)] p-3 font-mono text-[11px] text-[color:var(--color-text-bright)] overflow-x-auto whitespace-pre"><code>card_id = sha256(asset_url || title)[:16]</code></pre>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The manifest carries
        <code class="text-[color:var(--color-signal-cyan)]">csv_sha256</code>
        for cheap upstream-change detection. Every stage skips work it has
        already done for unchanged
        <code class="text-[color:var(--color-signal-cyan)]">card_id</code>s.
        Re-running on an unchanged manifest is a no-op modulo timestamps.
      </p>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        The manifest itself is shaped like this (one entry per card):
      </p>
      <pre class="bg-[color:var(--color-bg-elevated)] border border-[color:var(--color-border)] p-3 font-mono text-[11px] text-[color:var(--color-text)] overflow-x-auto whitespace-pre"><code>{`{
  "source_url": "https://www.war.gov/.../uap-data.csv",
  "fetched_at": "2026-05-08T19:21:00Z",
  "csv_sha256": "${csvShort}…",
  "cards": [
    {
      "card_id": "0b298cfc9c65a4d6",
      "title": "NASA-UAP-D6, Apollo 17 Technical Crew Debriefing, 1973",
      "asset_type": "PDF",
      "agency": "NASA",
      "release_date": "...",
      "asset_url": "https://www.war.gov/.../apollo-17.pdf",
      "redacted": false,
      "raw": { ...original CSV row... }
    }
  ]
}`}</code></pre>
    </section>

    {/* What we don't do */}
    <section id="not-do" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ What we don't do
      </h2>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-2 pl-5 list-disc marker:text-[color:var(--color-text-faint)]">
        <li>
          <span class="text-[color:var(--color-text-bright)]">No data modification.</span>
          The Raw OCR transcript is the engine's literal output. We do not
          spell-check, hand-correct, or "smooth" the canonical text. The
          opt-in
          <a href="#reader-cleanup" class="text-[color:var(--color-signal-cyan)] underline decoration-[color:var(--color-border-bright)] hover:decoration-[color:var(--color-signal-cyan)]">Cleaned overlay</a>{" "}
          fixes obvious OCR errors without changing meaning; Raw stays
          canonical and is what citations point to.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">No transcription guessing.</span>
          Under the operated <code class="text-[color:var(--color-signal-cyan)]">llm-dots</code>{" "}
          engine, Sonnet 4.6 reads the page image directly; on the rare page
          its output filter blocks, the local dots.mocr backstop re-OCRs from
          the same image — not a "rewrite" of broken text. Each engine sees the
          source pixels independently.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">No redaction inference.</span>
          Black bars in the source are preserved as
          <code class="text-[color:var(--color-signal-red)]">[REDACTED]</code>
          tokens. We do not speculate about what was withheld.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">No silent updates.</span>
          When the upstream CSV changes, the diff is captured in the manifest
          history. Every release of this site is reproducible from the
          archived CSV snapshots.
        </li>
      </ul>
    </section>

    {/* Limitations */}
    <section id="limitations" class="border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 space-y-3 scroll-mt-20">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)]">
        ▸ Limitations
      </h2>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Honest framing — these are the failure modes you should expect
        when reading OCR output from this corpus:
      </p>
      <ul class="text-sm leading-relaxed text-[color:var(--color-text)] space-y-2 pl-5 list-disc marker:text-[color:var(--color-text-faint)]">
        <li>
          <span class="text-[color:var(--color-text-bright)]">Faded scans.</span>
          The 1947–1968 FBI material varies wildly in scan quality. Claude
          Sonnet 4.6 vision (the llm-dots primary) handles the worst pages
          much better than baseline OCR but is not perfect.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">Reading order.</span>
          Multi-column forms — particularly the carbon-copy intake forms
          common in the FBI files — occasionally lose reading order. Column
          detection is heuristic.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">Redaction boundaries.</span>
          When a redaction crosses a word boundary or sits inline with
          surrounding text, the OCR output may lose adjacent characters.
        </li>
        <li>
          <span class="text-[color:var(--color-text-bright)]">Handwriting.</span>
          Marginalia and signatures are inconsistently captured; the LLM
          fallback handles them best but at API cost.
        </li>
      </ul>
      <p class="text-sm leading-relaxed text-[color:var(--color-text)]">
        Engine-by-engine numbers from the golden-set benchmark are below.
      </p>
    </section>

