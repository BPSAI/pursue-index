---
import Base from "../layouts/Base.astro";
import TimelineIsland from "../components/TimelineIsland.tsx";
import { manifest } from "../data/manifest-loader";
// Native ES imports — Astro's bundler resolves these at build time and
// inlines them into the route's static output. Prior version used
// node:fs `readFileSync` which silently returned empty in the
// Cloudflare Pages build context (verified 2026-05-15: `approved` prop
// was [] on prod despite data files being committed). The ES-import
// pattern matches diff.astro's card-aliases import and works
// identically across Astro's dev + production builds.
import displayDatesJson from "../../../data/display_dates.json";
import proposalsJson from "../../../data/display_dates_proposals.json";

interface RawDateEntry {
  card_id: string;
  display_date?: string | null;
  display_date_range?: [string, string] | null;
  display_date_evidence?: string | null;
  display_date_abstention?: string | null;
  display_date_curator?: string | null;
}

const approved: RawDateEntry[] = (displayDatesJson as any).entries ?? [];
const proposals: RawDateEntry[] = proposalsJson as RawDateEntry[];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="TIMELINE — PURSUE://INDEX" active="timeline">
  <div class="space-y-6 max-w-6xl">
    <header class="space-y-2 border-b border-[color:var(--color-border)] pb-4">
      <div aria-hidden="true" class="font-mono text-[11px] uppercase tracking-[0.2em] text-[color:var(--color-signal-green)] flex items-center gap-2">
        <span class="text-[color:var(--color-text-faint)]">$</span>
        <span>plot --by display_date data/manifests/latest.json</span>
      </div>
      <h1 class="text-2xl font-mono font-semibold tracking-tight text-[color:var(--color-text-bright)]">
        TIMELINE
      </h1>
      <p class="text-sm text-[color:var(--color-text)] max-w-3xl">
        Every card in the corpus plotted at its curated <code class="text-[color:var(--color-signal-cyan)]">display_date</code> —
        the operator-approved point or year-precision date that beats the manifest's CSV
        <code class="text-[color:var(--color-signal-cyan)]">incident_date</code> field (which is unreliable for ~25% of the corpus
        per the <a href="https://github.com/BPSAI/pursue-index/issues/36" target="_blank" rel="noreferrer" class="text-[color:var(--color-signal-cyan)] underline">2026-05-15 field-shape finding</a>).
        Cards lacking a defensible single document date are surfaced in the "undated" bucket below — not hidden, not invented.
      </p>
    </header>
    <TimelineIsland
      client:load
      cards={manifest.cards}
      approved={approved}
      proposals={proposals}
      base={base}
    />
  </div>
</Base>
