# --- Storage ---
# Root for downloaded PDFs and OCR artifacts. Point at NAS mount on buschleague.
PURSUE_DATA_ROOT=/mnt/nas/pursue

# --- Database ---
PURSUE_DB_URL=postgresql+psycopg://pursue:pursue@localhost:5432/pursue

# --- Scrape ---
PURSUE_SOURCE_URL=https://www.war.gov/UFO/
PURSUE_SCRAPE_HEADLESS=true
PURSUE_SCRAPE_TIMEOUT_MS=30000
PURSUE_SCRAPE_USER_AGENT="pursue-index/0.1 (+https://bpsaisoftware.com)"

# --- Download ---
PURSUE_DOWNLOAD_CONCURRENCY=4
PURSUE_DOWNLOAD_RETRIES=5

# --- OCR ---
# Engine: "tesseract" | "azure" | "auto" (try tesseract first, fall back to azure)
PURSUE_OCR_ENGINE=auto
PURSUE_OCR_DPI=300
PURSUE_TESSERACT_BIN=/usr/bin/tesseract

# --- Azure Document Intelligence (optional, used when engine=azure or auto fallback) ---
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- API ---
PURSUE_API_HOST=0.0.0.0
PURSUE_API_PORT=8080

# --- Logging ---
PURSUE_LOG_LEVEL=INFO
PURSUE_LOG_FORMAT=console  # console | json
