# --- Storage ---
# data_root holds large derived artifacts (PDFs, OCR, videos, raw CSV archives).
# Point this at the NAS in production.
PURSUE_DATA_ROOT=./data
# manifests_dir is intentionally separate — manifests are small JSON files
# that live in the repo and are version-controlled. They never go on the NAS.
PURSUE_MANIFESTS_DIR=./data/manifests

# --- Database ---
PURSUE_DB_URL=postgresql+psycopg://pursue:pursue@localhost:5432/pursue

# --- Scrape ---
PURSUE_CSV_URL=https://www.war.gov/Portals/1/Interactive/2026/UFO/uap-csv.csv
# Empty value → use the realistic Chrome UA baked into csv_fetcher.
PURSUE_SCRAPE_USER_AGENT=

# --- Download ---
PURSUE_DOWNLOAD_CONCURRENCY=4
PURSUE_DOWNLOAD_RETRIES=5
# Whether to fetch DVIDS-hosted videos. Off by default — they're large and need
# a separate API to get a real download URL.
PURSUE_DOWNLOAD_VIDEOS=false

# --- OCR ---
# Engine: "tesseract" (CPU) | "surya" (GPU, [gpu] extra) | "llm" (vision, [llm] extra)
# | "auto" (primary engine + LLM fallback for pages below threshold)
PURSUE_OCR_ENGINE=auto
PURSUE_OCR_DPI=300
PURSUE_TESSERACT_BIN=/usr/bin/tesseract

# --- LLM OCR fallback (used when engine=auto or engine=llm; needs [llm] extra) ---
# Anthropic is the v1 implementation; OpenAI is a stub.
PURSUE_OCR_LLM_PROVIDER=anthropic
PURSUE_OCR_LLM_MODEL=claude-sonnet-4-6
# Pages with primary-engine confidence below this are re-OCR'd via the LLM.
PURSUE_OCR_LLM_THRESHOLD=70
# Read by the anthropic SDK directly:
ANTHROPIC_API_KEY=

# --- API ---
PURSUE_API_HOST=0.0.0.0
PURSUE_API_PORT=8080

# --- Logging ---
PURSUE_LOG_LEVEL=INFO
PURSUE_LOG_FORMAT=console  # console | json
